// SPDX-License-Identifier: GPL-3.0-or-later
//
// A supervisor, in TOS Core.
//
// It reads a policy module and announces what that policy names. Both halves are
// canonical text: the policy is a module of this capsule, and this is a module
// of this capsule, and the only privileged thing in the picture is the nucleus
// that answers the operation.
//
// **It used to start them.** `SYSTEM_INTERFACE_V1` §4 declared `process_create`
// over `SYSTEM_ABI_V1` operation 8, and ADR-0076 §4 retires that operation.
// Creation is funded now, and the schema carries it again: `process_create_funded`
// takes two capabilities, a sealed launch plan and an explicit grant, and returns
// the child's capability (ADR-0077). What this module does is the half that was
// never in question — read a policy it does not contain and reach a real
// capability contract once per entry — and it is left that way deliberately, so
// that the policy-reading claim is evidenced by a module that does nothing else.
//
// That is docs/37's Stage 3 identity question answered for the system's own
// structure, and not just for one operation: "do textual processes exercise real
// capability/IPC contracts rather than running as decorative scripts around
// privileged binary services?" The thing that reads the policy and acts on it is
// text.
//
// It holds exactly one capability, and it is the one it asks for by name. What
// it may do with it is `send` and nothing else — it cannot receive what it
// announced, because nobody gave it that.

module system.boot.init version 1.0 profile full;

import system.policy.services as policy;
import capability system.ipc.Endpoint as endpoint;

resource [
    fuel: 65536,
    stack: 16KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 4
]

extern fn endpoint_send(cap: system.ipc.Endpoint, length: u64) -> i64 uses [endpoint];

// How many of the policy's components were announced successfully.
//
// The loop is over the policy's own count and each size is the policy's own —
// this module contains neither. One size is inside `IPC_V1` §3's inline bound
// and one is past it, so exactly one announcement is accepted; a supervisor that
// had ignored the policy could not have looped twice, and one that had faked the
// calls could not have got two different answers.
pub fn main() -> i64 uses [endpoint] {
    let mut announced: i64 = 0i64;
    let mut at: size = 0B;
    while (at < policy.count()) {
        let status: i64 = endpoint_send(endpoint, policy.announcement(at));
        if (status == 0i64) {
            announced = announced + 1i64;
        }
        at = at + 1B;
    }
    return announced;
}
