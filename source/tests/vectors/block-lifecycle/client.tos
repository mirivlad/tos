// SPDX-License-Identifier: GPL-3.0-or-later
//
// The client across one service restart. It holds no hardware authority at any
// point, and it is the only process in this boot that observes both instances.
//
//   look up            -> endpoint A
//   compose a pattern in a region of its own, freeze it
//   send it to A, then call A: write sector 8
//   look up again      -> answered while there is no publication at all, and
//                         nothing is delivered
//   look up a third time -> blocks until the successor has published -> endpoint B
//   send a region to B, then call B: read sector 8
//   receive a region   -> **all 512 bytes are the pattern A wrote**
//   call endpoint A    -> must not be served, while B is waiting to serve
//
// **The last step is the experiment, not a tidy-up.** ADR-0093 §3a.5 says a name
// minted for one instance must not silently become a name for another. This client
// still holds the name lookup gave it before the restart; B is alive and waiting
// for a request at the moment this call is made; and the call is not served. If
// the capability had been repaired, B would have answered it.
//
// **And the read proves persistence in the narrow sense Stage 4 claims.** The
// bytes were written through a service that no longer exists, and are read back
// through one that initialized the device itself. Nothing here claims power-loss
// durability, flush semantics or crash consistency — ADR-0092 puts those outside
// Stage 4.
//
// **Sector 8, and a pattern of its own.** Sectors 1 to 4 of the reference image
// are seeded and sector 0 is zero-filled, so a witness placed in any of them could
// be satisfied by the image. Sector 8 is untouched zeros, and the pattern is
// non-zero everywhere, so neither the image nor unwritten memory can pass for it.

module system.client.block version 1.5 profile full;

import capability system.ipc.Endpoint as registry;
import capability system.ipc.Endpoint as inbox;
import capability system.ipc.Endpoint as reply_to;
import capability system.memory.Authority as budget;

resource [
    fuel: 524288,
    stack: 8KiB,
    allocation: 2KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 8
]

extern fn endpoint_call_carrying(
    held: system.ipc.Endpoint,
    on: system.ipc.Endpoint,
    length: u64
) -> i64 uses [reply_to, registry];

extern fn endpoint_receive_call(
    cap: system.ipc.Endpoint
) -> Result<system.ipc.ReceivedCall, i64> uses [inbox];

extern fn endpoint_call_word_carrying(
    held: system.ipc.Endpoint,
    on: system.ipc.Endpoint,
    word: u64
) -> i64 uses [reply_to, system.ipc.Endpoint];

extern fn endpoint_send_region(
    cap: system.ipc.Endpoint, region: system.memory.Region
) -> i64 uses [system.ipc.Endpoint, system.memory.Region];

extern fn endpoint_receive_region(
    cap: system.ipc.Endpoint
) -> Result<Region<u8>, i64> uses [inbox];

extern fn region_allocate(
    cap: system.memory.Authority, bytes: size
) -> Result<Region<mut u8>, i64> uses [budget];

extern fn region_freeze(
    cap: system.memory.Region
) -> Result<Region<u8>, i64> uses [system.memory.Region];

const OK: i64 = 0i64;
const E_CANCELLED: i64 = -5i64;
// Untouched by the reference image's seeding, so nothing but this boot can have
// put anything there.
const TARGET_SECTOR: u64 = 8u64;
const WRITE_REQUEST: u64 = 17u64;
const READ_REQUEST: u64 = 16u64;
const SECTOR_BYTES: size = 512B;
const SECTOR_COUNT: u64 = 512u64;

// The pattern, computed from the index so that no byte of it is a copy of
// anything, and non-zero everywhere so that unwritten memory cannot pass for it.
fn pattern(at: u64) -> u64 {
    return (at * 37u64 + 91u64) % 251u64 + 1u64;
}

fn pattern_byte(at: u64) -> u8 {
    match (to_u8(pattern(at))) {
        Ok(byte) => { return byte; }
        Err(unconvertible) => { return 0u8; }
    }
}

fn compose(borrow mut payload: Region<mut u8>) -> unit {
    let mut at: size = 0B;
    let mut index: u64 = 0u64;
    while (at < SECTOR_BYTES) {
        payload[at] = pattern_byte(index);
        at = at + 1B;
        index = index + 1u64;
    }
}

// How many of the 512 bytes are the pattern. **Counted here and nowhere else:**
// the number this returns is what the boot reports, and no host-side check stands
// in for it.
fn agreeing(borrow payload: Region<u8>) -> u64 {
    let mut at: size = 0B;
    let mut index: u64 = 0u64;
    let mut agreed: u64 = 0u64;
    while (at < SECTOR_BYTES) {
        if ((payload[at] as u64) == pattern(index)) {
            agreed = agreed + 1u64;
        }
        at = at + 1B;
        index = index + 1u64;
    }
    return agreed;
}

// One exchange with whichever instance the argument names: a region, then a call.
fn exchange(service: system.ipc.Endpoint, word: u64) -> i64
    uses [reply_to, budget, system.ipc.Endpoint, system.memory.Region]
{
    match (region_allocate(budget, SECTOR_BYTES)) {
        Ok(payload) => {
            compose(borrow mut payload);
            match (region_freeze(payload)) {
                Ok(frozen) => {
                    if (endpoint_send_region(service, frozen) != OK) { return -101i64; }
                    return endpoint_call_word_carrying(reply_to, service, word);
                }
                Err(unfrozen) => { return unfrozen - 200i64; }
            }
        }
        Err(unallocated) => { return unallocated - 300i64; }
    }
}

// Asks the registry and takes the answer off the inbox.
fn look_up() -> Result<system.ipc.Endpoint, i64>
    uses [registry, inbox, reply_to, system.ipc.Endpoint]
{
    if (endpoint_call_carrying(reply_to, registry, 0u64) != OK) { return Err(-401i64); }
    match (endpoint_receive_call(inbox)) {
        Ok(delivery) => { return Ok(delivery.carried); }
        Err(refused) => { return Err(refused - 500i64); }
    }
}

// Asks, and takes nothing off the inbox.
//
// **The lookup that lands in the interval with no publication.** The registry's
// sequence puts it after the withdrawal and before the successor's registration,
// so this is where "there is nothing to hand out" is answered — and what makes it
// answerable at all is that a reply and a delivery are two separate things here
// (`ADR-0094` §11: an answer cannot carry a capability). A lookup that delivered
// nothing still gets its reply, and this client does not wait for an inbox message
// that is not coming.
fn probe() -> i64 uses [registry, reply_to, system.ipc.Endpoint] {
    return endpoint_call_carrying(reply_to, registry, 0u64);
}

//   1  the first lookup was answered
//   2  the write through the first instance was acknowledged
//   4  a lookup was answered in the interval with **no publication in existence**
//   8  the third lookup was answered — which could not return until the successor
//      had published
//  16  the read through the successor was acknowledged
//  32  a region arrived on this client's inbox
//  64  **all 512 bytes are the pattern written before the first instance died**
// 128  and the name the first lookup gave is still a name for the instance that is
//      gone: a call on it was cancelled rather than served, while the successor was
//      waiting for a request
pub fn main() -> i64
    uses [registry, inbox, reply_to, budget, system.ipc.Endpoint,
          system.memory.Region]
{
    let mut found: i64 = 0i64;

    match (look_up()) {
        Ok(first) => {
            found = found + 1i64;
            if (exchange(first, WRITE_REQUEST) != OK) { return -1001i64; }
            found = found + 2i64;

            // **The interval with no publication.** This lookup is answered after
            // the withdrawal and before the successor registers, because that is
            // where the registry's own sequence puts it — and it is answered with
            // nothing, which is why no inbox message is waited for.
            if (probe() != OK) { return -1501i64; }
            found = found + 4i64;

            // **This blocks until the successor has published.** The registry
            // answers lookups in order and will not reach this one until it has
            // taken a second registration, so the boot's ordering is the
            // registry's rather than a guess about timing.
            match (look_up()) {
                Ok(second) => {
                    found = found + 8i64;
                    if (exchange(second, READ_REQUEST) != OK) { return -2001i64; }
                    found = found + 16i64;
                    match (endpoint_receive_region(inbox)) {
                        Ok(payload) => {
                            found = found + 32i64;
                            if (agreeing(borrow payload) == SECTOR_COUNT) {
                                found = found + 64i64;
                            }
                        }
                        Err(refused) => { return refused - 3000i64; }
                    }
                    // --- the stale name, with the successor alive and waiting ---
                    let stale: i64 = endpoint_call_word_carrying(reply_to, first, READ_REQUEST);
                    if (stale == E_CANCELLED) { found = found + 128i64; }
                    if (stale == OK) { return -4001i64; }
                }
                Err(refused) => { return refused - 2500i64; }
            }
        }
        Err(refused) => { return refused - 900i64; }
    }

    return found;
}
