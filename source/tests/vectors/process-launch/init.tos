// SPDX-License-Identifier: GPL-3.0-or-later
//
// A TOS Core module that declares an operation the accepted schema no longer
// carries.
//
// It used to launch a process. `SYSTEM_INTERFACE_V1` §4 declared
// `process_create` over `system.process.Control`, bound to `SYSTEM_ABI_V1`
// operation 8 — and ADR-0076 §4 retires that operation, because it funded a
// process out of the boot's accounting anchor with nobody presenting a
// `MemoryAuthority`. Creation is operation 19 now, and this schema cannot carry
// it as it stands: 19 requires two capabilities, an explicit runtime grant and
// an explicit endowment, and it returns the child's *capability* rather than
// only a status.
//
// So the declaration below names an operation the schema does not have, and this
// module is refused **before its first instruction** — at the boundary check,
// with a reason that says exactly that. That is the evidence: a withdrawal is
// only real if a module that assumes otherwise cannot run.
//
// Everything else about the module is unchanged and legal. It asks for
// authority it is granted, its resource declaration is the same, and the
// refusal is about one line.

module system.boot.init version 1.0 profile full;

import capability system.process.Control as control;

resource [
    fuel: 65536,
    stack: 16KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 1
]

// The withdrawn operation. `system.process.Control` still declares
// `process_terminate`, so the interface resolves and the capability resolves;
// what does not is this name.
extern fn process_create(cap: system.process.Control, path: string) -> i64 uses [control];

pub fn main() -> i64 uses [control] {
    let made: i64 = process_create(control, "system/boot/init.tos");
    return made;
}
