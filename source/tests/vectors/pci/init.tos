// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4A: a textual module reads a real PCI device's configuration space.
//
// It holds exactly one capability, and it is the one it asked for by name: the
// **root PCI bus authority** the launcher minted (ADR-0079 §5, §9). That
// authority is not derived from anything — a bus exists because the machine has
// one — so it is the first capability in this system whose origin is the
// boot/platform boundary rather than an operation or a parent.
//
// From it the module claims one function and then reads that function's
// configuration space through the capability the claim produced. It never
// imported `platform.pci.FunctionConfig` and could not have: no launcher can
// answer a request for an object that does not exist until the claim runs. It
// declares the interface as an **effect** instead (ADR-0080), which says which
// class of authority this function may exercise and grants none of it — the
// capability the operation acts on is the value the claim returned.
//
// **Every number below comes from the device.** This module contains no vendor
// identifier, no device identifier and no class code to compare against; it
// reports what it read, and the harness — which cannot reach into the guest —
// decides whether that is a VirtIO block device. The nucleus cannot decide it
// either: it performs a configuration transaction against the function a
// capability names and has no idea what a VirtIO device is.

module system.boot.init version 1.1 profile full;

import capability platform.pci.Bus as bus;

resource [
    fuel: 65536,
    stack: 16KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 4
]

extern fn pci_function_claim(
    cap: platform.pci.Bus,
    bus_number: u64,
    device: u64,
    function: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [bus];

extern fn pci_config_read(
    cap: platform.pci.FunctionConfig,
    offset: u64,
    width: u64
) -> Result<u64, i64> uses [platform.pci.FunctionConfig];

// What the device says about itself, packed into the one value a module returns.
//
//   bits  0..15   vendor id      offset 0x00, 2 bytes
//   bits 16..31   device id      offset 0x02, 2 bytes
//   bits 32..39   class code     offset 0x0B, 1 byte
//   bits 40..47   subclass       offset 0x0A, 1 byte
//   bits 48..55   capability ptr offset 0x34, 1 byte
//
// The harness decodes it. Packing rather than five separate reports is what lets
// one `TOS.RUN.COMPLETED` carry the whole observation, and every field is a
// number this module read rather than one it holds.
fn observation(function: platform.pci.FunctionConfig) -> i64
    uses [platform.pci.FunctionConfig]
{
    let mut packed: u64 = 0u64;
    match (pci_config_read(function, 0u64, 2u64)) {
        Ok(vendor) => {
            packed = packed | vendor;
        }
        Err(status) => {
            return status - 200i64;
        }
    }
    match (pci_config_read(function, 2u64, 2u64)) {
        Ok(device) => {
            packed = packed | (device << 16u64);
        }
        Err(status) => {
            return status - 300i64;
        }
    }
    match (pci_config_read(function, 11u64, 1u64)) {
        Ok(class) => {
            packed = packed | (class << 32u64);
        }
        Err(status) => {
            return status - 400i64;
        }
    }
    match (pci_config_read(function, 10u64, 1u64)) {
        Ok(subclass) => {
            packed = packed | (subclass << 40u64);
        }
        Err(status) => {
            return status - 500i64;
        }
    }
    match (pci_config_read(function, 52u64, 1u64)) {
        Ok(capabilities) => {
            packed = packed | (capabilities << 48u64);
        }
        Err(status) => {
            return status - 600i64;
        }
    }
    match (to_i64(packed)) {
        Ok(value) => {
            return value;
        }
        Err(problem) => {
            return -700i64;
        }
    }
}

// The device at the Stage 4 profile's fixed location, read through authority
// derived from the bus root.
pub fn main() -> i64 uses [bus, platform.pci.FunctionConfig] {
    match (pci_function_claim(bus, 0u64, 4u64, 0u64)) {
        Ok(function) => {
            return observation(function);
        }
        Err(status) => {
            return status - 100i64;
        }
    }
}
