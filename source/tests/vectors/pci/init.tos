// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4A: a textual module takes authority over one real PCI function.
//
// It holds exactly one capability, and it is the one it asked for by name: the
// **root PCI bus authority** the launcher minted (ADR-0079 §5, §9). That
// authority is not derived from anything — a bus exists because the machine has
// one — so it is the first capability in this system whose origin is the
// boot/platform boundary rather than an operation or a parent.
//
// What this module does with it is claim functions out of its scope, which is
// what possession of a bus capability *is* the authority to do. Every number
// below is one the nucleus produced against real hardware: this module contains
// no device identity, no assignment table and no opinion about what a function
// at bus 0 device 4 might be.
//
// **What it deliberately does not do is read configuration space.** Not because
// Stage 4A does not want it, but because a module cannot yet declare an
// operation on `platform.pci.FunctionConfig`: `SYSTEM_INTERFACE_V1` §4.1 makes
// an `extern`'s `uses` name an `import capability` of the enclosing module, the
// import must be answered before the first instruction runs, and the only lawful
// producer of a function capability is the claim below — which runs after. That
// is the case ADR-0078 §6 recorded as open ("a capability of an interface a
// module never imports … is a separate question"), reached for the first time
// here. It is reported rather than worked around.

module system.boot.init version 1.0 profile full;

import capability platform.pci.Bus as bus;

resource [
    fuel: 65536,
    stack: 16KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 4
]

extern fn pci_function_claim(
    cap: platform.pci.Bus,
    bus_number: u64,
    device: u64,
    function: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [bus];

// Four findings, each a bit, and no single answer produces the number.
//
//   1  a function of the real machine was claimed out of this capability's scope
//   2  claiming it a second time was refused — the assignment is exclusive
//   4  a device number outside its architectural range was refused
//   8  a *different* function was claimed, so the refusal above was about the
//      function and not about the table having one entry
//
// A module that ignored the answers could not produce 15: two of the four
// require a refusal and two require a success, and the nucleus decides which is
// which against the hardware and the assignment table.
pub fn main() -> i64 uses [bus] {
    let mut findings: i64 = 0i64;
    match (pci_function_claim(bus, 0u64, 4u64, 0u64)) {
        Ok(claimed) => {
            findings = findings + 1i64;
        }
        Err(status) => {
            findings = findings + 0i64;
        }
    }
    // The same function again. Exclusive means exclusive: one live assignment
    // per function under one root, so this is `E_LIMIT` and not a second name.
    match (pci_function_claim(bus, 0u64, 4u64, 0u64)) {
        Ok(again) => {
            findings = findings + 0i64;
        }
        Err(status) => {
            if (status == -6i64) {
                findings = findings + 2i64;
            }
        }
    }
    // Device 32 does not exist in any PCI topology: five bits address a device.
    // A fact about the argument, refused without consulting any authority.
    match (pci_function_claim(bus, 0u64, 32u64, 0u64)) {
        Ok(impossible) => {
            findings = findings + 0i64;
        }
        Err(status) => {
            if (status == -3i64) {
                findings = findings + 4i64;
            }
        }
    }
    // A different function, to show the second claim's refusal was about the
    // function rather than about capacity.
    match (pci_function_claim(bus, 0u64, 5u64, 0u64)) {
        Ok(other) => {
            findings = findings + 8i64;
        }
        Err(status) => {
            findings = findings + 0i64;
        }
    }
    return findings;
}
