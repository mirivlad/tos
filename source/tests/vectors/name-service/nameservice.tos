// SPDX-License-Identifier: GPL-3.0-or-later
//
// The interface registry, as ADR-0093 P3 decided it: an ordinary textual
// service. The nucleus holds no interface namespace, the supervisor holds no
// registry, and the rules below are canonical text a reader can check.
//
// **Two endpoints, and the separation is the authority.** A process that can
// reach `publish` may register; one that can only reach `lookup` cannot, and
// not because this module checks a list — because it holds no name for the
// other endpoint. That is `CAPABILITY_V1` §6's "a process that holds it may
// register; one that does not, cannot", realised with nothing new.
//
// **An answer cannot carry a capability**, so the answer to a lookup is not
// the delivery. `ipc::hand` copies payload bytes from the replier's region
// into the waiting caller's and does not touch the transfer table. So a lookup
// hands over a channel to be answered on, this service sends the registered
// capability to that channel, and only then replies. Ordinary capability
// discipline, and the nucleus is untouched.
//
// **What arrives on `lookup` is never registered.** It is the asker's return
// channel and nothing else — which is what makes the second lookup below still
// answer with the publisher's endpoint after a client has carried its own.

module system.registry.nameservice version 1.4 profile full;

import capability system.ipc.Endpoint as publish;
import capability system.ipc.Endpoint as lookup;

resource [
    fuel: 16384,
    stack: 8KiB,
    allocation: 2KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 8,
    imports: 4
]

extern fn endpoint_receive_call(
    cap: system.ipc.Endpoint
) -> Result<system.ipc.ReceivedCall, i64> uses [system.ipc.Endpoint];

extern fn endpoint_send_carrying(
    held: system.ipc.Endpoint,
    on: system.ipc.Endpoint,
    length: u64
) -> i64 uses [system.ipc.Endpoint, system.ipc.Endpoint];

extern fn endpoint_reply(
    cap: system.ipc.Reply, length: u64
) -> i64 uses [system.ipc.Reply];

const OK: i64 = 0i64;

// Serves one registration and then two lookups, and ends. Ending is not
// tidiness: the client goes on using what it was given afterwards, and a
// registry that outlived every question could not show that.
//
//  1  the registration arrived, carrying a capability
//  2  the first lookup was answered with it
//  4  the second lookup was answered with it as well — what the client carried
//     into `lookup` registered nothing
pub fn main() -> i64
    uses [publish, lookup, system.ipc.Endpoint, system.ipc.Reply]
{
    let mut found: i64 = 0i64;

    // --- registration --------------------------------------------------------
    match (endpoint_receive_call(publish)) {
        Ok(registration) => {
            found = found + 1i64;
            let acknowledged: i64 = endpoint_reply(registration.reply, 0u64);
            if (acknowledged != OK) { return acknowledged - 1000i64; }

            // --- first lookup ------------------------------------------------
            match (endpoint_receive_call(lookup)) {
                Ok(first) => {
                    // `first.carried` is the asker's return channel. The
                    // registered capability goes to it; the channel itself is
                    // not remembered.
                    if (endpoint_send_carrying(registration.carried, first.carried, 0u64) == OK) {
                        found = found + 2i64;
                    }
                    let answered: i64 = endpoint_reply(first.reply, 0u64);
                    if (answered != OK) { return answered - 2000i64; }
                }
                Err(refused) => { return refused - 3000i64; }
            }

            // --- second lookup -----------------------------------------------
            // The same registered capability. Nothing the first asker carried
            // changed what this service holds.
            match (endpoint_receive_call(lookup)) {
                Ok(second) => {
                    if (endpoint_send_carrying(registration.carried, second.carried, 0u64) == OK) {
                        found = found + 4i64;
                    }
                    let answered: i64 = endpoint_reply(second.reply, 0u64);
                    if (answered != OK) { return answered - 4000i64; }
                }
                Err(refused) => { return refused - 5000i64; }
            }
        }
        Err(refused) => { return refused - 6000i64; }
    }

    return found;
}
