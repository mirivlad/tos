// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4C-2's teardown obligations, exercised rather than described
// (ADR-0084 §8.4, §8.9a, §8.9b, §8.11, §8.12, §8.13a).
//
// A driver releases a DMA region while the function it reaches is still a bus
// master. The frames must not go back to the pool, the charge must not come back
// to the budget, and the assignment must not end — until the nucleus has proved
// that nothing the device issued can still land in them. This module makes the
// situations in which a wrong implementation would give something back early,
// and reports what it was given back.
//
//   1  a function with no PCI Express capability is given no DMA authority,
//      although the profile qualified it (§8.9a — P1 is checked, not assumed)
//   2  the ordering and coherency bits of the target's Device Control and Device
//      Control 2 are refused, and their neighbours in the same registers are not
//      (§8.9b)
//   3  with an interrupt source keeping the function mastering, two
//      allocate/release cycles spend a two-frame budget, and a third allocation
//      from it is refused — while the parent budget still funds one at the same
//      moment, so the refusal is the child's budget and not the pool, the region
//      table or the quarantine table (§8.12, the churn case)
//   4  the source goes; only then do the frames come back, and the child budget
//      funds an allocation again (§8.11, §8.4)
//   5  the function goes; the same BDF can be claimed again (§8.13a's converse)
//
// **The same source runs against a device that never goes quiet** — a nucleus
// build in which the function's Device Status always reports Transactions Pending.
// Items 1–3 are unchanged there, and 4 and 5 must fail: the frames stay out, the
// charge stays outstanding, the assignment does not end and the BDF cannot be
// claimed again (§8.13a). A nucleus that refunded on release, or reclaimed on
// `BME = 0` alone, would turn one of the two boots red.
//
// **Every status below comes from the nucleus.** The module names no expectation;
// it reports what happened as one composed value, and the harness — which cannot
// reach into the guest — decides whether that is the contract.

module system.boot.init version 1.3 profile full;

import capability platform.pci.Bus as device;
import capability system.memory.Authority as budget;

resource [
    fuel: 262144,
    stack: 32KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 16,
    imports: 12
]

extern fn pci_function_claim(
    cap: platform.pci.Bus,
    bus_number: u64,
    device_number: u64,
    function_number: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [device];

extern fn pci_config_read(
    cap: platform.pci.FunctionConfig,
    offset: u64,
    width: u64
) -> Result<u64, i64> uses [platform.pci.FunctionConfig];

extern fn pci_config_write(
    cap: platform.pci.FunctionConfig,
    offset: u64,
    width: u64,
    value: u64
) -> i64 uses [platform.pci.FunctionConfig];

extern fn pci_interrupt_claim(
    cap: platform.pci.FunctionConfig,
    entry: u64
) -> Result<platform.irq.Source, i64> uses [platform.pci.FunctionConfig];

extern fn dma_region_allocate(
    function: platform.pci.FunctionConfig,
    authority: system.memory.Authority,
    bytes: size
) -> Result<DmaRegion<mut u8>, i64> uses [platform.pci.FunctionConfig, budget];

extern fn capability_attenuate_scoped(
    cap: system.memory.Authority,
    bytes: u64
) -> Result<system.memory.Authority, i64> uses [budget];

extern fn capability_release(region: platform.dma.Region) -> i64
    uses [platform.dma.Region];

extern fn capability_release(cap: platform.irq.Source) -> i64
    uses [platform.irq.Source];

extern fn capability_release(
    cap: platform.pci.FunctionConfig
) -> i64 uses [platform.pci.FunctionConfig];

extern fn capability_release(cap: system.memory.Authority) -> i64 uses [budget];

// `SYSTEM_ABI_V1` §4, named so that every assertion below can be checked against
// the contract rather than against a bare number.
const OK: i64 = 0i64;
const E_NO_CAPABILITY: i64 = -1i64;
const E_BAD_ARGUMENT: i64 = -3i64;
const E_LIMIT: i64 = -6i64;

// The reference target, and the machine's own ICH9 SATA function — which is a
// conventional PCI function on the root complex and carries no PCI Express
// capability. The nucleus reports `express=` for both, so the premise is
// asserted by ring 0 rather than taken from this comment.
const TARGET_BUS: u64 = 1u64;
const TARGET_DEVICE: u64 = 0u64;
const TARGET_FUNCTION: u64 = 0u64;
const CONVENTIONAL_BUS: u64 = 0u64;
const CONVENTIONAL_DEVICE: u64 = 31u64;
const CONVENTIONAL_FUNCTION: u64 = 2u64;

// One frame, which is the granule a DMA region is charged in. The child budget is
// exactly two of them, so a third region is one charge too many **only** if the
// first two are still charged.
const FRAME: u64 = 4096u64;
const REGION: size = 4096B;
const CHILD_FRAMES: u64 = 2u64;

// The capability list (PCI Local Bus §6.7) and the PCI Express capability's two
// control registers (PCIe Base §7.5.3.4, §7.5.3.16).
const CAPABILITY_POINTER: u64 = 52u64;
const MAX_CAPABILITIES: u64 = 48u64;
const EXPRESS_ID: u64 = 16u64;
const NO_EXPRESS: u64 = 0u64;
const EXPRESS_CAPABILITIES: u64 = 2u64;
const DEVICE_CONTROL: u64 = 8u64;
const DEVICE_CONTROL_2: u64 = 40u64;

// The bits the nucleus owns (ADR-0084 §5c) and one ordinary neighbour of each.
// Relaxed Ordering and No Snoop are bits 4 and 11 of Device Control; the
// neighbour is bit 0, Correctable Error Reporting Enable, which only decides
// whether an error is reported. ID-Based Ordering is bits 8 and 9 of Device
// Control 2; its neighbour is bit 4, Completion Timeout Disable.
const RELAXED_ORDERING: u64 = 16u64;
const NO_SNOOP: u64 = 2048u64;
const CORRECTABLE_REPORTING: u64 = 1u64;
const IDO_REQUEST: u64 = 256u64;
const IDO_COMPLETION: u64 = 512u64;
const COMPLETION_TIMEOUT_DISABLE: u64 = 16u64;

// What the module observed, one bit per fact. Composed so that no single status
// produces it: every bit is a separate observation, and a missing one says which.
const SAW_NO_EXPRESS_REFUSED: i64 = 1i64;
const SAW_ORDERING_OWNED: i64 = 2i64;
const SAW_NEIGHBOURS_WRITABLE: i64 = 4i64;
const SAW_CHURN_BOUNDED: i64 = 8i64;
const SAW_PARENT_FUNDS: i64 = 16i64;
const SAW_REFUND_AFTER_SOURCE: i64 = 32i64;
const SAW_RECLAIM_ON_CLAIM: i64 = 64i64;

fn read_at(function: platform.pci.FunctionConfig, offset: u64, width: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    match (pci_config_read(function, offset, width)) {
        Ok(value) => { return value; }
        Err(status) => { return 4294967296u64; }
    }
}

// Whether one power-of-two bit is set, without a bitwise operator.
fn has_bit(value: u64, bit: u64) -> bool {
    return value % (bit + bit) >= bit;
}

// The same value with one bit the other way round, whichever way it was.
fn flipped(value: u64, bit: u64) -> u64 {
    if (has_bit(value, bit)) { return value - bit; }
    return value + bit;
}

// The same value with one bit set.
fn with_bit(value: u64, bit: u64) -> u64 {
    if (has_bit(value, bit)) { return value; }
    return value + bit;
}

// Where the function's PCI Express capability is, or `NO_EXPRESS`.
//
// **Bounded by a count and not by the chain**: a chain that loops is a device
// telling a lie, and a walk that followed it would never end.
fn express_capability(function: platform.pci.FunctionConfig) -> u64
    uses [platform.pci.FunctionConfig]
{
    let mut at: u64 = read_at(function, CAPABILITY_POINTER, 1u64);
    let mut walked: u64 = 0u64;
    while (walked < MAX_CAPABILITIES) {
        if (at < 64u64 || at > 252u64) {
            return NO_EXPRESS;
        }
        if (read_at(function, at, 1u64) == EXPRESS_ID) {
            return at;
        }
        at = read_at(function, at + 1u64, 1u64);
        walked = walked + 1u64;
    }
    return NO_EXPRESS;
}

// §8.9a. The profile qualified this function (the launcher constant says so, and
// the nucleus reports `dma=1`), so what refuses is the missing Express capability
// and nothing else: without Transactions Pending a reclaim could never be proved.
fn no_express_refused() -> i64
    uses [device, platform.pci.FunctionConfig, budget, platform.dma.Region]
{
    match (pci_function_claim(device, CONVENTIONAL_BUS, CONVENTIONAL_DEVICE,
                              CONVENTIONAL_FUNCTION)) {
        Ok(function) => {
            // The module's own reading agrees with the nucleus's: no Express
            // capability anywhere in the chain.
            if (express_capability(function) != NO_EXPRESS) {
                return -11i64;
            }
            let mut refused: i64 = -12i64;
            match (dma_region_allocate(function, budget, REGION)) {
                Ok(region) => {
                    let dropped: i64 = capability_release(region);
                    refused = -13i64;
                }
                Err(status) => {
                    if (status == E_BAD_ARGUMENT) {
                        refused = SAW_NO_EXPRESS_REFUSED;
                    } else {
                        refused = status - 1400i64;
                    }
                }
            }
            if (capability_release(function) != OK) {
                return -14i64;
            }
            return refused;
        }
        Err(status) => {
            return status - 1500i64;
        }
    }
}

// §8.9b. Each owned bit is refused on its own, a write-back of what is there is
// permitted, and a neighbour in the same register changes. Every register is put
// back as it was found.
fn ordering_bits(function: platform.pci.FunctionConfig, express: u64) -> i64
    uses [platform.pci.FunctionConfig]
{
    let control_at: u64 = express + DEVICE_CONTROL;
    let control: u64 = read_at(function, control_at, 2u64);
    if (control > 65535u64) { return -21i64; }
    // The claim cleared all four owned bits (ADR-0084 §5c), whatever the firmware
    // left; that is the state the refusals below are refusals *from*.
    if (has_bit(control, RELAXED_ORDERING) || has_bit(control, NO_SNOOP)) {
        return -22i64;
    }
    let mut owned: i64 = 0i64;
    if (pci_config_write(function, control_at, 2u64, with_bit(control, RELAXED_ORDERING))
        == E_NO_CAPABILITY) {
        owned = owned + 1i64;
    }
    if (pci_config_write(function, control_at, 2u64, with_bit(control, NO_SNOOP))
        == E_NO_CAPABILITY) {
        owned = owned + 1i64;
    }
    if (pci_config_write(function, control_at, 2u64, control) == OK) {
        owned = owned + 1i64;
    }
    let mut neighbours: i64 = 0i64;
    if (pci_config_write(function, control_at, 2u64,
                         flipped(control, CORRECTABLE_REPORTING)) == OK) {
        neighbours = neighbours + 1i64;
    }
    if (pci_config_write(function, control_at, 2u64, control) != OK) {
        return -23i64;
    }

    // Device Control 2 exists from capability version 2 on; the reference
    // endpoint reports version 2, and a version-1 function would have nothing
    // here to refuse.
    let express_version: u64 = read_at(function, express + EXPRESS_CAPABILITIES, 2u64) % 16u64;
    if (express_version < 2u64) { return -24i64; }
    let control2_at: u64 = express + DEVICE_CONTROL_2;
    let control2: u64 = read_at(function, control2_at, 2u64);
    if (control2 > 65535u64) { return -25i64; }
    if (has_bit(control2, IDO_REQUEST) || has_bit(control2, IDO_COMPLETION)) {
        return -26i64;
    }
    if (pci_config_write(function, control2_at, 2u64, with_bit(control2, IDO_REQUEST))
        == E_NO_CAPABILITY) {
        owned = owned + 1i64;
    }
    if (pci_config_write(function, control2_at, 2u64, with_bit(control2, IDO_COMPLETION))
        == E_NO_CAPABILITY) {
        owned = owned + 1i64;
    }
    if (pci_config_write(function, control2_at, 2u64, control2) == OK) {
        owned = owned + 1i64;
    }
    if (pci_config_write(function, control2_at, 2u64,
                         flipped(control2, COMPLETION_TIMEOUT_DISABLE)) == OK) {
        neighbours = neighbours + 1i64;
    }
    if (pci_config_write(function, control2_at, 2u64, control2) != OK) {
        return -27i64;
    }
    // Nothing the refusals touched moved.
    if (read_at(function, control_at, 2u64) != control) { return -28i64; }
    if (read_at(function, control2_at, 2u64) != control2) { return -29i64; }

    let mut seen: i64 = 0i64;
    if (owned == 6i64) { seen = seen + SAW_ORDERING_OWNED; }
    if (neighbours == 2i64) { seen = seen + SAW_NEIGHBOURS_WRITABLE; }
    return seen;
}

// One allocate/release cycle from `funding`. `OK` when both succeeded; the
// allocation's own status when it was refused; a distinguished value when the
// release was.
fn cycle(function: platform.pci.FunctionConfig, funding: system.memory.Authority) -> i64
    uses [platform.pci.FunctionConfig, budget, platform.dma.Region]
{
    match (dma_region_allocate(function, funding, REGION)) {
        Ok(region) => {
            if (capability_release(region) != OK) {
                return -100i64;
            }
            return OK;
        }
        Err(status) => {
            return status;
        }
    }
}

// §8.11 and §8.12, with the source live and then gone.
fn churn(function: platform.pci.FunctionConfig) -> i64
    uses [platform.pci.FunctionConfig, budget, platform.dma.Region, platform.irq.Source]
{
    // The sibling that keeps the function mastering. An interrupt source is a
    // bus-mastering descendant (ADR-0082 §5d) — an MSI-X message is a memory
    // write — so while it lives, no release can be proved quiet.
    match (pci_interrupt_claim(function, 0u64)) {
        Ok(source) => {
            match (capability_attenuate_scoped(budget, CHILD_FRAMES * FRAME)) {
                Ok(child) => {
                    let mut seen: i64 = 0i64;
                    // Two cycles spend the child's two frames, **if** a release
                    // gives nothing back while the source lives.
                    if (cycle(function, child) != OK) { return -31i64; }
                    if (cycle(function, child) != OK) { return -32i64; }
                    let third: i64 = cycle(function, child);
                    // The control: the parent budget funds a region at this same
                    // moment, so the region table, the quarantine table and the
                    // pool all had room — and the third refusal was the child's
                    // budget alone.
                    //
                    // Written out rather than through [`cycle`]: an import is a
                    // capability position of an operation and not a value a local
                    // function can be handed.
                    let mut parent: i64 = -101i64;
                    match (dma_region_allocate(function, budget, REGION)) {
                        Ok(region) => {
                            if (capability_release(region) == OK) { parent = OK; }
                        }
                        Err(status) => { parent = status; }
                    }
                    if (third == E_LIMIT && parent == OK) {
                        seen = seen + SAW_CHURN_BOUNDED + SAW_PARENT_FUNDS;
                    } else {
                        if (parent == OK) { seen = seen + SAW_PARENT_FUNDS; }
                    }
                    // The sibling goes. On a device that goes quiet this is the
                    // moment the three quarantined runs are proved and returned;
                    // on one that never does, it changes nothing.
                    if (capability_release(source) != OK) { return -33i64; }
                    // Refunded exactly when reclaimed: the child funds a region
                    // again only if its two charges came back with the frames.
                    if (cycle(function, child) == OK) {
                        seen = seen + SAW_REFUND_AFTER_SOURCE;
                    }
                    if (capability_release(child) != OK) { return -34i64; }
                    return seen;
                }
                Err(status) => {
                    return status - 3500i64;
                }
            }
        }
        Err(status) => {
            return status - 3600i64;
        }
    }
}

pub fn main() -> i64
    uses [device, platform.pci.FunctionConfig, budget, platform.dma.Region,
          platform.irq.Source]
{
    let first: i64 = no_express_refused();
    if (first < 0i64) { return first; }
    let mut seen: i64 = first;

    match (pci_function_claim(device, TARGET_BUS, TARGET_DEVICE, TARGET_FUNCTION)) {
        Ok(function) => {
            let express: u64 = express_capability(function);
            if (express == NO_EXPRESS) { return -41i64; }
            let ordering: i64 = ordering_bits(function, express);
            if (ordering < 0i64) { return ordering; }
            seen = seen + ordering;
            let churned: i64 = churn(function);
            if (churned < 0i64) { return churned; }
            seen = seen + churned;
            // The last name goes. The assignment ends only if nothing is
            // quarantined against it (ADR-0084 §5d) — which is what the second
            // claim below asks.
            if (capability_release(function) != OK) { return -42i64; }
        }
        Err(status) => {
            return status - 4300i64;
        }
    }
    match (pci_function_claim(device, TARGET_BUS, TARGET_DEVICE, TARGET_FUNCTION)) {
        Ok(again) => {
            seen = seen + SAW_RECLAIM_ON_CLAIM;
            if (capability_release(again) != OK) { return -44i64; }
        }
        Err(status) => {
            // `E_LIMIT` is "already assigned": the pinned assignment of a
            // quarantine whose drain was never proved. Anything else is a defect
            // this module cannot explain.
            if (status != E_LIMIT) { return status - 4500i64; }
        }
    }
    return seen;
}
