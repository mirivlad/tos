// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4D-4: two real block reads outstanding together in one split virtqueue.
//
// Stage 4D-3 proved the queue is **reusable**: two sequential
// `VIRTIO_BLK_T_IN` requests through one initialized queue, the first
// request's descriptors reclaimed and reused to compose the second. Its loop
// was submit, wait, consume, reclaim, submit — and it said so out loud. At no
// instant did the device hold more than one chain of this driver's.
//
// This proves **queue depth greater than one**. Both requests are constructed,
// both chains are built out of a pool that holds exactly two of them, both
// chain heads are written into consecutive available-ring slots, and then
// **one** store to `avail.idx` moves it by two:
//
//   avail.ring[i    ] = head A
//   avail.ring[i + 1] = head B
//   dma_publish                      <- §2.7.13 step 4
//   avail.idx = i + 2                <- §2.7.13 step 5, ONE store, added = 2
//   dma_publish                      <- §2.7.13 step 6
//   notify                           <- §2.7.13 step 7
//
// **The single store is the claim.** Two stores of `+1` would be a different
// program even with nothing between them: §2.7.13.3 says that once `avail.idx`
// is updated "the device MAY access the descriptor chains the driver created
// and the memory they refer to immediately", so after a first `+1` the device
// may legally finish request A before the second store ever lands — and such a
// run would prove nothing this driver did not already prove in 4D-3. Going
// from `i` to `i + 2` in one store is §2.7.13.2's own batching form:
// "in general the driver MAY add many descriptor chains before it updates idx
// (at which point they become visible to the device)".
//
// **Six descriptors, two chains, zero free.** The pool is exactly two chains
// wide, so after both allocations the free count is zero and neither chain can
// have been reclaimed to make room for the other. Nothing is published until
// every one of the six is PREPARED, and nothing is reclaimed until a used
// entry names its own chain.
//
// **Completion order is not assumed.** `VIRTIO_F_IN_ORDER` is not negotiated,
// §2.6 says a device "is not generally required to use buffers in the same
// order in which they have been made available by the driver", and §5.2.6 says
// of block requests that "they are used by the device (not necessarily in
// order)". So identity is `used_elem.id`, matched against the two outstanding
// heads: the ring slot a completion arrives in says nothing about which
// request it is. Either order completes this boot, and which one happened is
// reported as a measurement rather than asserted.
//
// **Two independent witnesses.** Each request has its own header, its own
// 512-byte device-writable buffer and its own status byte, so no completion
// can be satisfied by the other's bytes. Request A reads sector 1 into a
// buffer poisoned 0xA5 and must find 512 copies of 0xC1; request B reads
// sector 2 into a buffer poisoned 0x5A and must find 512 copies of 0xC2.
// Neither untouched memory, nor either poison, nor the other request's result
// can satisfy either witness, whichever order they complete in.
//
// **One 8 KiB DMA region.** The queue substrate is byte for byte where Stage
// 4D-3 put it and request A's storage is at Stage 4D-3's offsets; request B's
// is appended after it under the same alignment rules, and the whole thing is
// one region, one `dma_region_allocate`, one capability-table entry. Two
// requests do not fit 4 KiB: the ring ends at 3342 and two request blocks need
// 1075 bytes more than the 754 that remain.
//
// **Batching is supported, not required.** One MSI-X message may cover both
// completions or each may bring its own; a wake may find nothing fresh and be
// waited past; a second message may arrive while this driver is draining
// rather than waiting, and ADR-0082's pending latch makes the next `irq_wait`
// return without blocking. All of those are legal and none of them is
// asserted — the driver drains until both requests are accounted for, and the
// counts it observed are reported as measurements.
//
// **Nothing new is asked of the nucleus.** No operation, no interface version,
// no capability type, no language minor, no schema change. A descriptor, a
// chain, a request identity, a ring index and a sector are words that occur
// only above the boundary.
//
// **What this does not prove.** That the device executed both requests at the
// same physical instant. What is proved is that this driver never offered the
// device a state in which only one chain was outstanding: both were exposed by
// one ownership publication, and neither was consumed or reclaimed until after
// it. Nothing here is a write, a second queue, a scheduler, a block service or
// a driver framework, and none of those is designed.
//
// Written against:
//
//   Virtual I/O Device (VIRTIO) Version 1.4
//   Committee Specification 01, 8 April 2026
//   OASIS, docs.oasis-open.org/virtio/virtio/v1.4/cs01/
//
// §2.6 completion order, §2.7.5 the descriptor table and chaining, §2.7.6 the
// available ring, §2.7.8 the used ring and its `id`/`len`, §2.7.9
// `VIRTIO_F_IN_ORDER`, §2.7.13 the seven steps and the two barriers, §2.7.13.2
// adding many chains before one idx update, §2.7.13.3 `avail->idx += added`,
// §2.7.14 consuming used entries, §2.7.7.1 spurious notifications, §2.7.10.1
// the used ring's flags, §4.1.4 the common configuration and the notification
// location, §4.1.5.1.2 MSI-X, and §5.2.6 the block request and its status.
module system.boot.init version 1.4 profile full;

import capability platform.pci.Bus as device;
import capability system.memory.Authority as budget;

resource [
    fuel: 4194304,
    stack: 32KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 16,
    imports: 8
]

extern fn pci_function_claim(
    cap: platform.pci.Bus,
    bus_number: u64,
    device: u64,
    function: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [device];

extern fn pci_config_read(
    cap: platform.pci.FunctionConfig,
    offset: u64,
    width: u64
) -> Result<u64, i64> uses [platform.pci.FunctionConfig];

extern fn pci_bar_map_write(
    cap: platform.pci.FunctionConfig,
    bar: u64,
    offset: size,
    length: size
) -> Result<MmioRegionMut, i64> uses [platform.pci.FunctionConfig];

extern fn pci_interrupt_claim(
    cap: platform.pci.FunctionConfig,
    entry: u64
) -> Result<platform.irq.Source, i64> uses [platform.pci.FunctionConfig];

extern fn dma_region_allocate(
    function: platform.pci.FunctionConfig,
    authority: system.memory.Authority,
    bytes: size
) -> Result<DmaRegion<mut u8>, i64> uses [platform.pci.FunctionConfig, budget];

extern fn irq_wait(cap: platform.irq.Source) -> i64 uses [platform.irq.Source];

extern fn dma_device_address(
    region: platform.dma.Region,
    offset: size
) -> Result<u64, i64> uses [platform.dma.Region];

const OK: i64 = 0i64;

// --- the device's capability list (PCI, and VIRTIO §4.1.4.1) ------------------
//
// A well-formed chain has at most this many entries in 256 bytes.
const MAX_CAPABILITIES: u64 = 64u64;
const FIRST_CAPABILITY: u64 = 64u64;
const LAST_CAPABILITY: u64 = 240u64;
const CAPABILITY_POINTER: u64 = 52u64;
const UNREADABLE: u64 = 256u64;

// `struct virtio_pci_cap`: cap_vndr, cap_next, cap_len, cfg_type, bar, id,
// padding[2], le32 offset, le32 length. `cap_vndr` 0x09 is a vendor-specific
// capability and `cfg_type` 1 is VIRTIO_PCI_CAP_COMMON_CFG.
const CAP_VENDOR: u64 = 9u64;
const CFG_TYPE_COMMON: u64 = 1u64;
const CAP_CFG_TYPE: u64 = 3u64;
const CAP_BAR: u64 = 4u64;
const CAP_OFFSET: u64 = 8u64;
const CAP_LENGTH: u64 = 12u64;

// --- the common configuration (VIRTIO §4.1.4.3) --------------------------------
const DEVICE_FEATURE_SELECT: size = 0B;
const DEVICE_FEATURE: size = 4B;
const DRIVER_FEATURE_SELECT: size = 8B;
const DRIVER_FEATURE: size = 12B;
const DEVICE_STATUS: size = 20B;
const QUEUE_SELECT: size = 22B;
const QUEUE_SIZE: size = 24B;
const QUEUE_MSIX_VECTOR: size = 26B;
const QUEUE_ENABLE: size = 28B;
const QUEUE_DESC: size = 32B;
const QUEUE_DRIVER: size = 40B;
const QUEUE_DEVICE: size = 48B;
// The last byte this module reads or writes, one past the end of `queue_device`.
const COMMON_CFG_USED: u64 = 56u64;

const STATUS_ACKNOWLEDGE: u64 = 1u64;
const STATUS_DRIVER: u64 = 2u64;
const STATUS_DRIVER_OK: u64 = 4u64;
const STATUS_FEATURES_OK: u64 = 8u64;
const STATUS_FAILED: u64 = 128u64;

// `VIRTIO_F_VERSION_1` is feature bit 32 — bit 0 of the high dword (§6.3).
// **Exactly one feature is accepted**, as in Stage 4D-1 and 4D-2. Reuse depends
// on no optional feature: `VIRTIO_F_INDIRECT_DESC`, `VIRTIO_F_EVENT_IDX`,
// `VIRTIO_F_IN_ORDER` and `VIRTIO_F_RING_RESET` are all left unnegotiated, so
// the recycling below is the plain split-ring discipline of §2.7.
const VERSION_1_IN_HIGH_DWORD: u64 = 1u64;

// The MSI-X table entry this driver gives the queue. An entry index of this
// function, never a CPU vector.
const QUEUE_ENTRY: u64 = 0u64;

// --- this driver's own bounds --------------------------------------------------
//
// **A Stage 4 driver cap, not an architectural maximum.** 128 descriptors is a
// real, useful queue whose whole split-ring substrate is 2048 + 262 + (2
// padding) + 1030 = 3342 bytes, exactly where Stage 4D-3 put it.
const QUEUE_CAP: u64 = 128u64;

// **The floor is the pool, and the pool is two chains.** Stage 4D-3's floor of
// four was enough for a driver that never held more than one chain; this one
// holds two at once, so a device offering fewer than six descriptors cannot
// serve it and is refused before any descriptor index is used. The reference
// device offers 128, and this driver does not rely on that.
const QUEUE_FLOOR: u64 = 6u64;

// **Eight KiB, and one region.** The ring ends at 3342 and two request blocks
// need 1075 bytes, which is 321 more than a 4 KiB region has left. One
// `dma_region_allocate` of twice the size rather than a second region: the
// device addresses stay derived from bounded offsets into one base, the
// capability table still gains exactly one entry, and request A's storage stays
// byte for byte at Stage 4D-3's offsets with request B's appended after it.
const REGION_BYTES: size = 8192B;
const QUEUE_ENABLED: u64 = 1u64;

// The reference profile's assertion about where the common configuration is
// (Stage 4 profile revision 2).
const PROFILE_COMMON_OFFSET: u64 = 0u64;

// `VIRTIO_PCI_CAP_NOTIFY_CFG` (§4.1.4.1), and the `le32 notify_off_multiplier`
// that follows the common capability header (§4.1.4.4).
const CFG_TYPE_NOTIFY: u64 = 2u64;

// `VIRTIO_F_NOTIFICATION_DATA` is feature bit 38 — bit 6 of the high dword.
// §4.1.4.4.1 selects the notification *capability* requirements by whether the
// device **offers** it; §4.1.5.2.1 selects a 16- or 32-bit driver notification
// by whether the driver **negotiated** it. Two clauses, two questions.
const NOTIFICATION_DATA_IN_HIGH_DWORD: u64 = 64u64;
const CAP_LENGTH_BYTE: u64 = 2u64;
const NOTIFY_CAP_BYTES: u64 = 20u64;
const CAP_NOTIFY_MULTIPLIER: u64 = 16u64;
const QUEUE_NOTIFY_OFF: size = 30B;

// **One window over the whole BAR**, because the common configuration and the
// Queue Notify address live in the same one on the reference endpoint.
const WINDOW_BYTES: size = 16384B;
const WINDOW_LIMIT: u64 = 16384u64;

// This driver's own bound on where a notification may live, so the conversion
// below is bounded by something this module decided rather than by a
// device-reported `le32`.
const NOTIFY_CHUNK: u64 = 256u64;

// --- the requests (VIRTIO §5.2.6) ----------------------------------------------
//
//   struct virtio_blk_req { le32 type; le32 reserved; le64 sector; u8 data[];
//                           u8 status; }
const BLK_T_IN: u64 = 0u64;
const BLK_S_OK: u64 = 0u64;
const HEADER_BYTES: size = 16B;
const SECTOR_BYTES: size = 512B;
const SECTOR_COUNT: u64 = 512u64;
const STATUS_BYTES: size = 1B;

// **Two requests, outstanding together, over two different sectors.** Not one,
// because one cannot be outstanding with anything; not more, because the claim
// is that the queue holds more than one chain rather than that it holds a
// workload. Everything below is sized by this number and by nothing else.
const OUTSTANDING: u64 = 2u64;
const FIRST_SECTOR: u64 = 1u64;

// What the Stage 4 backing image holds, as the profile seeds it: sector `n`
// carries 512 copies of `CONTENT_BASE + n` for the seeded sectors, and sector 0
// is left zero-filled so Stage 4D-2's witness is untouched. **The rule is the
// contract with the profile**, and the module computes the byte it expects from
// the sector it asked for rather than carrying a table of answers.
const CONTENT_BASE: u64 = 192u64;

// **The sentinels, one per request, in one buffer each.** `VIRTIO_BLK_T_IN` is
// 0 and `VIRTIO_BLK_S_OK` is 0, so "not zero" proves nothing; and the two
// requests are outstanding together, so they cannot share a buffer at all. Each
// has its own 512 bytes, poisoned with a different non-zero byte that is
// neither sector's content, and what is checked is that the device replaced
// that request's poison with that request's sector — whichever order the two
// completed in.
const SENTINEL_A: u64 = 165u64;
const SENTINEL_B: u64 = 90u64;
const STATUS_SENTINEL: u64 = 255u64;

// Descriptor flags (§2.7.5). `INDIRECT` is not used and not negotiated.
const DESC_F_NEXT: u64 = 1u64;
const DESC_F_WRITE: u64 = 2u64;
const DESC_BYTES: size = 16B;

// --- the descriptor pool, and what owns each descriptor ------------------------
//
// §2.7.13.1 says only "Get the next free descriptor table entry, d", and notes
// that a driver usually chains free descriptors and keeps a count. **The
// protocol does not specify a recycling mechanism**, so this is the driver's
// own, and it is kept in driver-private memory rather than in the descriptor
// table's `next` fields: bookkeeping the device can see is bookkeeping the
// device can be blamed for.
//
// **Six descriptors of the 128-entry table, which is exactly two chains.**
// Three are spent on each of the two requests, so after both allocations the
// free count is zero: neither chain can have been reclaimed to make room for
// the other, and a third chain is arithmetically impossible. Stage 4D-3's pool
// was four — one chain short of two — which is what forced its requests to be
// sequential and is the reason this pool is a different size rather than a
// bigger one.
//
// **The pool size is written three times and that is a language limit, not a
// choice.** `POOL_COUNT` counts in `u64` because every descriptor index is a
// `u64`; `POOL_SLOTS` is the same number as a `size` because the free queue's
// modulo and every array index are `size`, and TOS Core V1 has no conversion
// between the two domains; and the `array<u64, 4>` declarations below repeat it
// as a literal because the parser requires a literal there
// (`E1104_EXPECTED_LITERAL`) even though `docs/40` §3 says a named constant is
// admissible as an array's compile-time `size`. Changing the pool means
// changing all three, and the consistency check below is what notices when one
// of them was missed.
const POOL_COUNT: u64 = 6u64;
const POOL_SLOTS: size = 6B;
const CHAIN_LENGTH: u64 = 3u64;
const CHAIN_SLOTS: size = 3B;

// The lifecycle, one value per state. A descriptor is handed out only from
// FREE, published only from PREPARED, reclaimed only from DEVICE, and returned
// to the free queue only from COMPLETED — so a descriptor the device still owns
// has no path back into a chain.
//
//   FREE       the driver's, and in the free queue
//   PREPARED   written for a request, not yet exposed
//   DEVICE     exposed by `avail.idx`; the driver may not touch it
//   COMPLETED  named by a used entry, not yet returned to the queue
const DESC_FREE: u64 = 0u64;
const DESC_PREPARED: u64 = 1u64;
const DESC_DEVICE: u64 = 2u64;
const DESC_COMPLETED: u64 = 3u64;

// --- ring index arithmetic (VIRTIO §2.7.6, §2.7.14) ----------------------------
//
// "idx always increments, and wraps naturally at 65536" (§2.7.13.3), and the
// ring slot is the index taken modulo the queue size. Both counters below are
// kept in that 16-bit space by construction.
const RING_MODULUS: u64 = 65536u64;
const RING_LAST: u64 = 65535u64;

// How many wakes this driver will tolerate per request before giving up. A wake
// is a delivery fact and not a completion (ADR-0082 §7), and §2.7.7.1 requires
// a driver to handle spurious notifications — so this counts them rather than
// assuming the first one means the request finished.
const MAX_WAKES: u64 = 16u64;

fn byte_at(function: platform.pci.FunctionConfig, offset: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    match (pci_config_read(function, offset, 1u64)) {
        Ok(value) => { return value; }
        Err(status) => { return UNREADABLE; }
    }
}

fn dword_at(function: platform.pci.FunctionConfig, offset: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    match (pci_config_read(function, offset, 4u64)) {
        Ok(value) => { return value; }
        Err(status) => { return 4294967296u64; }
    }
}

// Where the device says its common configuration is: the capability list is
// walked, and the first `VIRTIO_PCI_CAP_COMMON_CFG` decides. Returns the
// capability's own offset in configuration space, or 0 when there is none.
fn common_capability(function: platform.pci.FunctionConfig) -> u64
    uses [platform.pci.FunctionConfig]
{
    let mut at: u64 = byte_at(function, CAPABILITY_POINTER);
    let mut steps: u64 = 0u64;
    let mut found: u64 = 0u64;
    while (steps < MAX_CAPABILITIES) {
        if (at < FIRST_CAPABILITY) {
            steps = MAX_CAPABILITIES;
        }
        if (steps < MAX_CAPABILITIES) {
            if (at > LAST_CAPABILITY) {
                steps = MAX_CAPABILITIES;
            }
        }
        if (steps < MAX_CAPABILITIES) {
            if (byte_at(function, at) == CAP_VENDOR) {
                if (byte_at(function, at + CAP_CFG_TYPE) == CFG_TYPE_COMMON) {
                    found = at;
                    steps = MAX_CAPABILITIES;
                }
            }
            if (steps < MAX_CAPABILITIES) {
                at = byte_at(function, at + 1u64);
                steps = steps + 1u64;
            }
        }
    }
    return found;
}

// Rounds a size up to a multiple of `to`, with the language's checked
// arithmetic. VIRTIO §2.7 gives each ring part a minimum alignment, and every
// offset below is placed by this rather than by a constant somebody computed.
fn align_up(value: size, to: size) -> size {
    let rest: size = value % to;
    if (rest == 0B) {
        return value;
    }
    return (value - rest) + to;
}

// Multiplies a size by a count.
//
// **A loop rather than an operator**, and the reason is a real boundary rather
// than a preference: `size` is the exact type of every region index and every
// array index, and TOS Core V1 has no checked conversion whose destination is
// `size` (`docs/40` §3 fixes the set at `to_i8`..`to_u64`, and `to_u64` applied
// to a `size` traps as a type confusion). So a count held as `u64` cannot enter
// the `size` domain by conversion, and it enters by counting instead. Every
// caller below bounds its count first.
fn scale(unit: size, count: u64) -> size {
    let mut total: size = 0B;
    let mut done: u64 = 0u64;
    while (done < count) {
        total = total + unit;
        done = done + 1u64;
    }
    return total;
}

// A descriptor or pool index as the `size` an array wants. One call site's worth
// of `scale`, named for what it is.
fn slot(index: u64) -> size {
    return scale(1B, index);
}

// --- the 16-bit ring counters (VIRTIO §2.7.6, §2.7.13.3, §2.7.14) --------------
//
// `avail.idx` and `used.idx` are `le16` fields that **always increment and wrap
// at 65536**; the ring array they select is the queue size, which is a
// different and smaller modulus. Keeping the two apart is the whole of the
// arithmetic, and getting either wrong is invisible for the first few thousand
// requests — which is exactly why it is checked below rather than exercised.

// The next value of a 16-bit ring counter. `65535 -> 0`, and never 65536.
fn ring_next(index: u64) -> u64 {
    return (index + 1u64) % RING_MODULUS;
}

// **`avail->idx += added`** (§2.7.13.3), for an `added` greater than one.
//
// §2.7.13 step 5 is "the available idx is increased by the number of descriptor
// chain heads added to the available ring", and step 3 permits steps 1 and 2 to
// be "performed repeatedly if batching is possible". This is that increase, in
// the same 16-bit space as `ring_next` and wrapping the same way — and it is a
// separate function from `ring_next` because the whole claim of this stage is
// that the counter moves by two in one store rather than by one twice.
fn ring_add(index: u64, added: u64) -> u64 {
    return (index + added) % RING_MODULUS;
}

// How far `later` is ahead of `earlier` in the 16-bit ring counter space. This
// is §2.7.14's `last_seen_used != used.idx` made into a count, so that a device
// that published more used entries than this driver made chains available is a
// refusal rather than an entry read out of the wrong slot.
fn ring_distance(later: u64, earlier: u64) -> u64 {
    return ((later + RING_MODULUS) - earlier) % RING_MODULUS;
}

// Which ring array slot a 16-bit counter names, for a queue of `size` entries
// (§2.7.13.3: `avail->ring[avail->idx % qsz] = head;`).
fn ring_slot(index: u64, size: u64) -> u64 {
    return index % size;
}

// **The wrap is proved, not assumed.** This stage issues two requests, so no
// run of it reaches 65536 and no boot can exercise the wrap by arriving at it.
// Building a 65,536-request boot to force one would be a worse test than
// checking the primitive across the boundary directly, which is what this does:
// the successor of the last index, the successor of the first, a distance
// across the boundary, a longer distance across it, and the distance from a
// counter to itself.
//
// The slot modulus is checked with it, because the bug this guards against is
// using one modulus where the other belongs: at `index = 65535` a queue of 128
// is at slot 127, and at the next index it is at slot 0.
fn wrap_arithmetic_holds() -> bool {
    if (ring_next(RING_LAST) != 0u64) {
        return false;
    }
    if (ring_next(0u64) != 1u64) {
        return false;
    }
    if (ring_next(RING_LAST - 1u64) != RING_LAST) {
        return false;
    }
    if (ring_distance(0u64, RING_LAST) != 1u64) {
        return false;
    }
    if (ring_distance(3u64, RING_LAST - 2u64) != 6u64) {
        return false;
    }
    if (ring_distance(5u64, 5u64) != 0u64) {
        return false;
    }
    // `avail->idx += added` across the boundary, for the `added = 2` this stage
    // publishes with. Two steps of one and one step of two must agree, and both
    // must wrap rather than reach 65536.
    if (ring_add(RING_LAST, 2u64) != 1u64) {
        return false;
    }
    if (ring_add(65534u64, 2u64) != 0u64) {
        return false;
    }
    if (ring_add(0u64, 2u64) != ring_next(ring_next(0u64))) {
        return false;
    }
    if (ring_add(RING_LAST, 2u64) != ring_next(ring_next(RING_LAST))) {
        return false;
    }
    if (ring_distance(ring_add(RING_LAST, 2u64), RING_LAST) != 2u64) {
        return false;
    }
    if (ring_distance(RING_LAST, 0u64) != RING_LAST) {
        return false;
    }
    if (ring_slot(RING_LAST, QUEUE_CAP) != QUEUE_CAP - 1u64) {
        return false;
    }
    if (ring_slot(ring_next(RING_LAST), QUEUE_CAP) != 0u64) {
        return false;
    }
    return true;
}

// Whether a device-reported queue size is one this driver will use: nonzero, a
// power of two (VIRTIO §4.1.4.3.1, absent `VIRTIO_F_RING_PACKED`), and not
// below this driver's floor.
fn usable_queue(maximum: u64) -> bool {
    if (maximum == 0u64) {
        return false;
    }
    if ((maximum & (maximum - 1u64)) != 0u64) {
        return false;
    }
    return maximum >= QUEUE_FLOOR;
}

// **Adds status bits, and never replaces the byte** (VIRTIO §2.1.1).
//
// "The driver MUST update device status, setting bits to indicate the completed
// steps of the driver initialization sequence ... The driver MUST NOT clear a
// device status bit."
//
// So every non-zero transition is a read, an OR and a write — of the *device's*
// current byte, not of the history this module remembers. `DEVICE_NEEDS_RESET`
// is set by the **device** (§2.1.2), and a driver that rebuilt the byte from
// its own expected sequence would erase it.
//
// Returns the status the device reports afterwards, so a caller checks the bit
// it asked for rather than assuming the write took.
fn add_status(borrow mut window: MmioRegionMut, bits: u64) -> u64 {
    let current: u64 = mmio_read_u8(window, DEVICE_STATUS);
    mmio_write_u8(window, DEVICE_STATUS, current | bits);
    return mmio_read_u8(window, DEVICE_STATUS);
}

// Sets the FAILED status bit, which §3.1.1 permits after initialization has
// begun and irrecoverably failed. Additive, like every other transition.
fn give_up(borrow mut window: MmioRegionMut) -> unit {
    let ignored: u64 = add_status(borrow mut window, STATUS_FAILED);
}

// Zeroes the whole region, byte by byte.
//
// **Written rather than assumed.** A driver that relied on freshly allocated
// pages being zero would be depending on an allocator property no accepted
// document states, and the ring's flags and indices must be zero before the
// device is allowed to look at them.
fn zero_region(borrow mut region: DmaRegion<mut u8>, extent: size) -> unit {
    let mut at: size = 0B;
    while (at < extent) {
        region[at] = 0u8;
        at = at + 1B;
    }
}

// --- little-endian encoding, as bytes (VIRTIO §2.7.5, §5.2.6) -----------------
//
// The protocol representation stays explicit bytes. A typed DMA record would
// publish the frontend's layout choice as a binary format shared with a device,
// which ADR-0081 §3 refuses.

fn to_le_low(value: u64) -> u8 {
    match (to_u8(value % 256u64)) {
        Ok(byte) => { return byte; }
        Err(bad) => { return 0u8; }
    }
}

fn to_le_high(value: u64) -> u8 {
    match (to_u8((value / 256u64) % 256u64)) {
        Ok(byte) => { return byte; }
        Err(bad) => { return 0u8; }
    }
}

fn put_le16(borrow mut region: DmaRegion<mut u8>, at: size, value: u64) -> unit {
    region[at] = to_le_low(value);
    region[at + 1B] = to_le_high(value);
}

fn put_le32(borrow mut region: DmaRegion<mut u8>, at: size, value: u64) -> unit {
    put_le16(borrow mut region, at, value % 65536u64);
    put_le16(borrow mut region, at + 2B, (value / 65536u64) % 65536u64);
}

fn put_le64(borrow mut region: DmaRegion<mut u8>, at: size, value: u64) -> unit {
    put_le32(borrow mut region, at, value % 4294967296u64);
    put_le32(borrow mut region, at + 4B, value / 4294967296u64);
}

fn read_le16(borrow region: DmaRegion<mut u8>, at: size) -> u64 {
    let low: u8 = region[at];
    let high: u8 = region[at + 1B];
    return (high as u64) * 256u64 + (low as u64);
}

fn read_le32(borrow region: DmaRegion<mut u8>, at: size) -> u64 {
    let low: u64 = read_le16(borrow region, at);
    let high: u64 = read_le16(borrow region, at + 2B);
    return high * 65536u64 + low;
}

// One `struct virtq_desc` (§2.7.5), written at the table entry its index names.
//
// **The index is an argument**, which is the difference between this and the
// Stage 4D-2 driver that wrote descriptors 0, 1 and 2 at three fixed offsets.
fn write_descriptor(
    borrow mut region: DmaRegion<mut u8>,
    table: size,
    index: u64,
    address: u64,
    length: u64,
    flags: u64,
    next: u64
) -> unit {
    let at: size = table + scale(DESC_BYTES, index);
    put_le64(borrow mut region, at, address);
    put_le32(borrow mut region, at + 8B, length);
    put_le16(borrow mut region, at + 12B, flags);
    put_le16(borrow mut region, at + 14B, next);
}

// Brings the device up to the point where a queue may be configured: reset,
// ACKNOWLEDGE, DRIVER, feature negotiation, FEATURES_OK — VIRTIO §3.1.1 steps
// 1 through 6, in that order and no other.
//
// **Performed once for the whole boot.** Nothing below resets the device or
// renegotiates anything: that is the point of the stage.
//
// Returns 0, or a negative naming the step that did not hold.
fn negotiate(borrow mut window: MmioRegionMut) -> i64 {
    // Step 1. **Reset, and wait for the device to say so.** §4.1.4.3.2: after
    // writing 0 the driver must wait for a read of device_status to return 0
    // before reinitializing.
    mmio_write_u8(window, DEVICE_STATUS, 0u64);
    let mut waited: u64 = 0u64;
    let mut reset: bool = false;
    while (waited < 1024u64) {
        if (mmio_read_u8(window, DEVICE_STATUS) == 0u64) {
            reset = true;
            waited = 1024u64;
        }
        if (waited < 1024u64) {
            waited = waited + 1u64;
        }
    }
    if (!reset) {
        return -11i64;
    }

    // Steps 2 and 3.
    let acknowledged: u64 = add_status(borrow mut window, STATUS_ACKNOWLEDGE);
    let driving: u64 = add_status(borrow mut window, STATUS_DRIVER);

    // Step 4. The device must have offered `VERSION_1`; this driver accepts it
    // and nothing else.
    mmio_write_le_u32(window, DEVICE_FEATURE_SELECT, 1u64);
    let high: u64 = mmio_read_le_u32(window, DEVICE_FEATURE);
    if ((high & VERSION_1_IN_HIGH_DWORD) == 0u64) {
        give_up(borrow mut window);
        return -12i64;
    }
    mmio_write_le_u32(window, DRIVER_FEATURE_SELECT, 0u64);
    mmio_write_le_u32(window, DRIVER_FEATURE, 0u64);
    mmio_write_le_u32(window, DRIVER_FEATURE_SELECT, 1u64);
    mmio_write_le_u32(window, DRIVER_FEATURE, VERSION_1_IN_HIGH_DWORD);

    // Steps 5 and 6.
    let offered: u64 = add_status(borrow mut window, STATUS_FEATURES_OK);
    if ((offered & STATUS_FEATURES_OK) == 0u64) {
        give_up(borrow mut window);
        return -13i64;
    }
    return OK;
}

// Where the device says its notification structure is.
fn notify_capability(function: platform.pci.FunctionConfig) -> u64
    uses [platform.pci.FunctionConfig]
{
    let mut at: u64 = byte_at(function, CAPABILITY_POINTER);
    let mut steps: u64 = 0u64;
    let mut found: u64 = 0u64;
    while (steps < MAX_CAPABILITIES) {
        if (at < FIRST_CAPABILITY) {
            steps = MAX_CAPABILITIES;
        }
        if (steps < MAX_CAPABILITIES) {
            if (at > LAST_CAPABILITY) {
                steps = MAX_CAPABILITIES;
            }
        }
        if (steps < MAX_CAPABILITIES) {
            if (byte_at(function, at) == CAP_VENDOR) {
                if (byte_at(function, at + CAP_CFG_TYPE) == CFG_TYPE_NOTIFY) {
                    found = at;
                    steps = MAX_CAPABILITIES;
                }
            }
            if (steps < MAX_CAPABILITIES) {
                at = byte_at(function, at + 1u64);
                steps = steps + 1u64;
            }
        }
    }
    return found;
}

// Whether a value is a power of two. Zero is not one, which matters because
// §4.1.4.4.1 admits 0 as a *separate* alternative rather than as a power of two.
fn is_power_of_two(value: u64) -> bool {
    if (value == 0u64) {
        return false;
    }
    return (value & (value - 1u64)) == 0u64;
}

// The `notify_off_multiplier` rule of §4.1.4.4.1, **both branches**, selected by
// what the device *offers*.
fn multiplier_admitted(multiplier: u64, notification_data: bool) -> bool {
    if (multiplier == 0u64) {
        return true;
    }
    if (!is_power_of_two(multiplier)) {
        return false;
    }
    if (notification_data) {
        return (multiplier % 4u64) == 0u64;
    }
    return (multiplier % 2u64) == 0u64;
}

// What the device offers, read from its own register.
fn offered_high_dword(borrow mut window: MmioRegionMut) -> u64 {
    mmio_write_le_u32(window, DEVICE_FEATURE_SELECT, 1u64);
    return mmio_read_le_u32(window, DEVICE_FEATURE);
}

// Brings a device-reported offset into the `size` domain, **bounded twice**: by
// this driver's own window, then by a two-level count of at most
// `WINDOW_LIMIT / NOTIFY_CHUNK` chunks plus `NOTIFY_CHUNK - 1` bytes.
fn window_offset(value: u64) -> size {
    let chunks: u64 = value / NOTIFY_CHUNK;
    let rest: u64 = value % NOTIFY_CHUNK;
    return scale(256B, chunks) + scale(1B, rest);
}

// --- what the boot proves, one bit each ----------------------------------------
//
// The first fifteen are Stage 4D-1's and 4D-2's initialization facts. The rest
// are this slice's, and they divide into three kinds: what held before any
// request, what held for **every** request, and what held across the pair.
const PROVED_RESET: u64 = 1u64;
const PROVED_VERSION_1: u64 = 2u64;
const PROVED_FEATURES_OK: u64 = 4u64;
const PROVED_QUEUE_EXISTS: u64 = 8u64;
const PROVED_SIZE_ACCEPTED: u64 = 16u64;
const PROVED_LAYOUT_FITS: u64 = 32u64;
const PROVED_ALIGNMENT: u64 = 64u64;
const PROVED_DESC_READBACK: u64 = 128u64;
const PROVED_DRIVER_READBACK: u64 = 256u64;
const PROVED_DEVICE_READBACK: u64 = 512u64;
const PROVED_MSIX_ACCEPTED: u64 = 1024u64;
const PROVED_ENABLED: u64 = 2048u64;
const PROVED_DRIVER_OK: u64 = 4096u64;
const PROVED_REQUEST_FITS: u64 = 8192u64;
const PROVED_NOTIFY_FOUND: u64 = 16384u64;

// The 16-bit counter arithmetic, proved across 65535 -> 0 before the device is
// touched, and the pool's own consistency before a descriptor is handed out.
const PROVED_WRAP_ARITHMETIC: u64 = 32768u64;
const PROVED_POOL_READY: u64 = 65536u64;

// **The queue is wide enough for two chains.** A device offering fewer than six
// descriptors is refused before an index is used, rather than after.
const PROVED_QUEUE_HOLDS_POOL: u64 = 131072u64;

// **The two request blocks are disjoint**, so neither witness can be satisfied
// by the other request's bytes.
const PROVED_BLOCKS_DISJOINT: u64 = 262144u64;

// --- what only two chains at once can show ---------------------------------
//
// Six distinct descriptors in two disjoint chains; the pool empty afterwards,
// so nothing was reclaimed to make room; every member PREPARED and nothing
// consumed at the moment of publication; and after the single store that moves
// `avail.idx` by two, all six are the device's.
const PROVED_BOTH_ALLOCATED: u64 = 524288u64;
const PROVED_POOL_EMPTY: u64 = 1048576u64;
const PROVED_BOTH_PREPARED: u64 = 2097152u64;
const PROVED_NOTHING_CONSUMED: u64 = 4194304u64;
const PROVED_PUBLICATION_ADDED_TWO: u64 = 8388608u64;
const PROVED_BOTH_DEVICE_OWNED: u64 = 16777216u64;

// --- what held for each completion, in whichever order they arrived --------
const PROVED_USED_ID_MATCHED: u64 = 33554432u64;
const PROVED_LEN_COVERS_REQUEST: u64 = 67108864u64;
const PROVED_STATUS_OK: u64 = 134217728u64;
const PROVED_SECTORS_READ: u64 = 268435456u64;
const PROVED_CHAIN_RECLAIMED: u64 = 536870912u64;

// The complete set. No partial run can produce it: every bit above is added at
// the point its fact is established, and a failure returns a negative naming
// the step instead.
const PROVED_ALL: u64 = 1073741823u64;

// --- and the measurements carried above the mask -------------------------------
//
// Each field is bounded by this module before it is packed, so none can reach
// into the next: 3, 3, 3, 3, 1, 5, 2 and 8 bits, above 30 bits of mask.
//
// **Four of these are observations and not claims.** Which request completed
// first, how many wakes it took, the largest number of used entries one
// consume made visible, and whether a wait returned from the pending latch are
// all QEMU timing outcomes. The driver is written to be correct for every legal
// combination and reports what this boot happened to see.
const AVAIL_SHIFT: u64 = 1073741824u64;
const AVAIL_LIMIT: u64 = 7u64;
const USED_SHIFT: u64 = 8589934592u64;
const USED_LIMIT: u64 = 7u64;
const HEAD_A_SHIFT: u64 = 68719476736u64;
const HEAD_B_SHIFT: u64 = 549755813888u64;
const HEAD_LIMIT: u64 = 7u64;
const ORDER_SHIFT: u64 = 4398046511104u64;
const ORDER_LIMIT: u64 = 1u64;
const WAKES_SHIFT: u64 = 8796093022208u64;
const WAKES_LIMIT: u64 = 31u64;
const FRESH_SHIFT: u64 = 281474976710656u64;
const FRESH_LIMIT: u64 = 3u64;
const QUEUE_SHIFT: u64 = 1125899906842624u64;
const QUEUE_LIMIT: u64 = 255u64;

// Builds the queue exactly as Stage 4D-1 does, then exposes **two** chains to
// it with one ownership publication and drains both completions in whatever
// order the device produces them, without touching the device's configuration
// again.
//
// **Everything mutable that has to survive a request lives here**: the pool,
// its free queue, the producer counter and the consumer counter. TOS Core V1
// aggregates are `Copy`, so a `borrow mut array<...>` parameter would hand a
// callee a copy whose writes the caller never sees; keeping the state in one
// scope is the representation the language actually supports, and it is also
// the smallest one.
fn drive(
    borrow mut window: MmioRegionMut,
    region: DmaRegion<mut u8>,
    source: platform.irq.Source,
    notify_at: size
) -> i64 uses [platform.dma.Region, platform.irq.Source] {
    let mut proved: u64 = PROVED_RESET + PROVED_VERSION_1 + PROVED_FEATURES_OK
        + PROVED_NOTIFY_FOUND;

    // **Before the device is touched at all.** The counters below carry the
    // queue past 65536 requests, and this boot issues two — so the arithmetic
    // is checked across the boundary rather than exercised up to it.
    if (!wrap_arithmetic_holds()) {
        give_up(borrow mut window);
        return -20i64;
    }
    proved = proved + PROVED_WRAP_ARITHMETIC;

    mmio_write_le_u16(window, QUEUE_SELECT, 0u64);
    let maximum: u64 = mmio_read_le_u16(window, QUEUE_SIZE);
    if (!usable_queue(maximum)) {
        give_up(borrow mut window);
        return -21i64;
    }
    proved = proved + PROVED_QUEUE_EXISTS;

    let mut chosen: u64 = QUEUE_CAP;
    if (maximum < QUEUE_CAP) {
        chosen = maximum;
    }
    if (chosen < QUEUE_FLOOR) {
        give_up(borrow mut window);
        return -22i64;
    }
    // **The queue must hold two chains, not one.** The pool is indexed into the
    // descriptor table, so the table has to be at least as wide as the pool —
    // and this driver's pool is six, because it holds two chains of three at
    // once. A device offering fewer is refused here, before any descriptor
    // index exists, rather than relying on the reference device's 128.
    if (chosen < POOL_COUNT) {
        give_up(borrow mut window);
        return -24i64;
    }
    proved = proved + PROVED_QUEUE_HOLDS_POOL;

    let desc_offset: size = align_up(0B, 16B);
    let desc_bytes: size = scale(16B, chosen);
    let avail_offset: size = align_up(desc_offset + desc_bytes, 2B);
    let avail_bytes: size = 6B + scale(2B, chosen);
    let used_offset: size = align_up(avail_offset + avail_bytes, 4B);
    let used_bytes: size = 6B + scale(8B, chosen);
    let queue_end: size = used_offset + used_bytes;
    if (queue_end > REGION_BYTES) {
        give_up(borrow mut window);
        return -23i64;
    }
    proved = proved + PROVED_LAYOUT_FITS;

    // §2.7.10.1 requires `used.flags` to be initialised to 0 when the used ring
    // is allocated, and every other index and flag must be defined before the
    // device is allowed to look. Zeroing the whole extent settles all of it.
    zero_region(borrow mut region, REGION_BYTES);

    dma_publish(region);

    let mut desc_address: u64 = 0u64;
    match (dma_device_address(region, desc_offset)) {
        Ok(address) => { desc_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 300i64; }
    }
    let mut driver_address: u64 = 0u64;
    match (dma_device_address(region, avail_offset)) {
        Ok(address) => { driver_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 310i64; }
    }
    let mut device_address: u64 = 0u64;
    match (dma_device_address(region, used_offset)) {
        Ok(address) => { device_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 320i64; }
    }
    if ((desc_address % 16u64) != 0u64) {
        give_up(borrow mut window);
        return -25i64;
    }
    if ((driver_address % 2u64) != 0u64) {
        give_up(borrow mut window);
        return -26i64;
    }
    if ((device_address % 4u64) != 0u64) {
        give_up(borrow mut window);
        return -27i64;
    }
    proved = proved + PROVED_ALIGNMENT;

    mmio_write_le_u16(window, QUEUE_SIZE, chosen);
    if (mmio_read_le_u16(window, QUEUE_SIZE) != chosen) {
        give_up(borrow mut window);
        return -28i64;
    }
    proved = proved + PROVED_SIZE_ACCEPTED;

    mmio_write_le_u64(window, QUEUE_DESC, desc_address);
    if (mmio_read_le_u64(window, QUEUE_DESC) != desc_address) {
        give_up(borrow mut window);
        return -29i64;
    }
    proved = proved + PROVED_DESC_READBACK;

    mmio_write_le_u64(window, QUEUE_DRIVER, driver_address);
    if (mmio_read_le_u64(window, QUEUE_DRIVER) != driver_address) {
        give_up(borrow mut window);
        return -30i64;
    }
    proved = proved + PROVED_DRIVER_READBACK;

    mmio_write_le_u64(window, QUEUE_DEVICE, device_address);
    if (mmio_read_le_u64(window, QUEUE_DEVICE) != device_address) {
        give_up(borrow mut window);
        return -31i64;
    }
    proved = proved + PROVED_DEVICE_READBACK;

    mmio_write_le_u16(window, QUEUE_MSIX_VECTOR, QUEUE_ENTRY);
    if (mmio_read_le_u16(window, QUEUE_MSIX_VECTOR) != QUEUE_ENTRY) {
        give_up(borrow mut window);
        return -32i64;
    }
    proved = proved + PROVED_MSIX_ACCEPTED;

    // **The one and only `queue_enable`.** Nothing below writes it again, and
    // nothing below writes `device_status` except a refusal.
    mmio_write_le_u16(window, QUEUE_ENABLE, QUEUE_ENABLED);
    if (mmio_read_le_u16(window, QUEUE_ENABLE) != QUEUE_ENABLED) {
        give_up(borrow mut window);
        return -33i64;
    }
    proved = proved + PROVED_ENABLED;

    let live: u64 = add_status(borrow mut window, STATUS_DRIVER_OK);
    if ((live & STATUS_DRIVER_OK) == 0u64) {
        give_up(borrow mut window);
        return -34i64;
    }
    proved = proved + PROVED_DRIVER_OK;

    // **Two request blocks, derived from where the ring actually ended.**
    //
    // Request A's storage is exactly where Stage 4D-3 put its one request's —
    // the same `align_up` from the same `queue_end` — and request B's is
    // appended after it under the same alignment rules. Nothing is shared: two
    // headers, two 512-byte device-writable buffers and two status bytes, so a
    // completion can only be satisfied by the bytes of its own request.
    let header_a: size = align_up(queue_end, 16B);
    let data_a: size = align_up(header_a + HEADER_BYTES, 16B);
    let status_a: size = data_a + SECTOR_BYTES;
    let header_b: size = align_up(status_a + STATUS_BYTES, 16B);
    let data_b: size = align_up(header_b + HEADER_BYTES, 16B);
    let status_b: size = data_b + SECTOR_BYTES;
    let request_end: size = status_b + STATUS_BYTES;
    if (request_end > REGION_BYTES) {
        give_up(borrow mut window);
        return -51i64;
    }
    proved = proved + PROVED_REQUEST_FITS;

    // **And they are disjoint, checked rather than laid out and trusted.**
    // Request A's block ends before request B's begins, and each block's own
    // parts are in order — so no byte belongs to both requests and neither
    // witness below can be satisfied by the other request's device writes.
    let mut disjoint: bool = true;
    if (header_a + HEADER_BYTES > data_a) {
        disjoint = false;
    }
    if (data_a + SECTOR_BYTES > status_a) {
        disjoint = false;
    }
    if (status_a + STATUS_BYTES > header_b) {
        disjoint = false;
    }
    if (header_b + HEADER_BYTES > data_b) {
        disjoint = false;
    }
    if (data_b + SECTOR_BYTES > status_b) {
        disjoint = false;
    }
    if (queue_end > header_a) {
        disjoint = false;
    }
    if (!disjoint) {
        give_up(borrow mut window);
        return -50i64;
    }
    proved = proved + PROVED_BLOCKS_DISJOINT;

    // **Nine device addresses, nine bounded offsets, one region** (ADR-0084
    // §6b). Each is resolved by the nucleus from the same region base and an
    // offset this module computed; nothing adds to an address, and no scalar
    // address is supplied by this source.
    let mut header_a_address: u64 = 0u64;
    match (dma_device_address(region, header_a)) {
        Ok(address) => { header_a_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 340i64; }
    }
    let mut data_a_address: u64 = 0u64;
    match (dma_device_address(region, data_a)) {
        Ok(address) => { data_a_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 350i64; }
    }
    let mut status_a_address: u64 = 0u64;
    match (dma_device_address(region, status_a)) {
        Ok(address) => { status_a_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 360i64; }
    }
    let mut header_b_address: u64 = 0u64;
    match (dma_device_address(region, header_b)) {
        Ok(address) => { header_b_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 370i64; }
    }
    let mut data_b_address: u64 = 0u64;
    match (dma_device_address(region, data_b)) {
        Ok(address) => { data_b_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 380i64; }
    }
    let mut status_b_address: u64 = 0u64;
    match (dma_device_address(region, status_b)) {
        Ok(address) => { status_b_address = address; }
        Err(status) => { give_up(borrow mut window); return status - 390i64; }
    }

    // --- the pool: exactly two chains ----------------------------------------
    //
    // `owner` is the lifecycle state of each descriptor; `freeq` is a circular
    // FIFO of the descriptors that are free, `free_front` names the next one to
    // hand out and `free_held` how many there are. Six slots, three per chain:
    // after both allocations there is nothing left, which is what makes
    // "neither was reclaimed to make room for the other" arithmetic rather than
    // an assertion.
    let mut owner: array<u64, 6> = [DESC_FREE, DESC_FREE, DESC_FREE,
        DESC_FREE, DESC_FREE, DESC_FREE];
    let mut freeq: array<u64, 6> = [0u64, 1u64, 2u64, 3u64, 4u64, 5u64];
    let mut free_front: size = 0B;
    let mut free_held: u64 = POOL_COUNT;

    // The pool starts consistent: every descriptor free, and named exactly once
    // by the free queue. A pool that started with a duplicate would hand the
    // same descriptor to both chains and the disjointness below would be an
    // accident rather than a discipline.
    let mut seen: array<u64, 6> = [0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
    let mut scan: u64 = 0u64;
    while (scan < POOL_COUNT) {
        let named: u64 = freeq[slot(scan)];
        if (named < POOL_COUNT) {
            seen[slot(named)] = seen[slot(named)] + 1u64;
        }
        scan = scan + 1u64;
    }
    let mut consistent: bool = (free_held == POOL_COUNT);
    scan = 0u64;
    while (scan < POOL_COUNT) {
        if (seen[slot(scan)] != 1u64) {
            consistent = false;
        }
        if (owner[slot(scan)] != DESC_FREE) {
            consistent = false;
        }
        scan = scan + 1u64;
    }
    if (!consistent) {
        give_up(borrow mut window);
        return -52i64;
    }
    proved = proved + PROVED_POOL_READY;

    // **The two counters that make the queue reusable**, and that this stage
    // moves by two in one step. `avail_idx` is this driver's copy of the
    // producer index it publishes; `last_seen_used` is §2.7.14's consumer
    // index, which the device never writes.
    let mut avail_idx: u64 = 0u64;
    let mut last_seen_used: u64 = 0u64;
    let published_before: u64 = avail_idx;

    // --- both chains, out of the one pool ------------------------------------
    //
    // Allocated one after the other with nothing between them: no publication,
    // no notification, no wait and no reclaim. Only a FREE descriptor is ever
    // handed out and the free queue only ever receives descriptors the reclaim
    // step released, so there is no path from DEVICE back into a chain.
    let mut chain_a: array<u64, 3> = [0u64, 0u64, 0u64];
    let mut chain_b: array<u64, 3> = [0u64, 0u64, 0u64];
    let mut taken: u64 = 0u64;
    while (taken < CHAIN_LENGTH) {
        let picked: u64 = freeq[free_front];
        if (picked >= POOL_COUNT) {
            give_up(borrow mut window);
            return -54i64;
        }
        if (owner[slot(picked)] != DESC_FREE) {
            give_up(borrow mut window);
            return -55i64;
        }
        owner[slot(picked)] = DESC_PREPARED;
        chain_a[slot(taken)] = picked;
        free_front = (free_front + 1B) % POOL_SLOTS;
        free_held = free_held - 1u64;
        taken = taken + 1u64;
    }
    taken = 0u64;
    while (taken < CHAIN_LENGTH) {
        let picked: u64 = freeq[free_front];
        if (picked >= POOL_COUNT) {
            give_up(borrow mut window);
            return -54i64;
        }
        if (owner[slot(picked)] != DESC_FREE) {
            give_up(borrow mut window);
            return -55i64;
        }
        owner[slot(picked)] = DESC_PREPARED;
        chain_b[slot(taken)] = picked;
        free_front = (free_front + 1B) % POOL_SLOTS;
        free_held = free_held - 1u64;
        taken = taken + 1u64;
    }

    // **Six distinct descriptors in two disjoint chains.** Counted, not assumed:
    // every member of B is compared with every member of A, and a pool that had
    // handed one descriptor to both would be caught here rather than by the
    // device.
    //
    // **Which descriptors they are proves nothing about concurrency.** With a
    // six-slot FIFO, a driver that allocated A, reclaimed it and then allocated
    // B would be handed 3, 4 and 5 for B as well — A's three go back *behind*
    // the three still ahead of the front. The facts that do prove it are the
    // ones established immediately before the publication below: all six
    // PREPARED, the pool empty, nothing consumed, and one store exposing them.
    let mut distinct: bool = true;
    let mut mine: u64 = 0u64;
    while (mine < CHAIN_LENGTH) {
        let theirs_start: u64 = 0u64;
        let mut theirs: u64 = theirs_start;
        while (theirs < CHAIN_LENGTH) {
            if (chain_a[slot(mine)] == chain_b[slot(theirs)]) {
                distinct = false;
            }
            theirs = theirs + 1u64;
        }
        mine = mine + 1u64;
    }
    if (!distinct) {
        give_up(borrow mut window);
        return -80i64;
    }
    proved = proved + PROVED_BOTH_ALLOCATED;

    // --- both requests' bytes (§5.2.6) ---------------------------------------
    //
    //   struct virtio_blk_req { le32 type; le32 reserved; le64 sector;
    //                           u8 data[]; u8 status; }
    //
    // §5.2.6.1: "The length of data MUST be a multiple of 512 bytes for
    // VIRTIO_BLK_T_IN and VIRTIO_BLK_T_OUT requests." One sector each.
    let sector_a: u64 = FIRST_SECTOR;
    let sector_b: u64 = FIRST_SECTOR + 1u64;
    let expected_a: u64 = CONTENT_BASE + sector_a;
    let expected_b: u64 = CONTENT_BASE + sector_b;

    put_le32(borrow mut region, header_a, BLK_T_IN);
    put_le32(borrow mut region, header_a + 4B, 0u64);
    put_le64(borrow mut region, header_a + 8B, sector_a);
    put_le32(borrow mut region, header_b, BLK_T_IN);
    put_le32(borrow mut region, header_b + 4B, 0u64);
    put_le64(borrow mut region, header_b + 8B, sector_b);

    // **Each buffer is poisoned with its own byte**, and neither poison is
    // either sector's content or zero. The status bytes get a third sentinel,
    // because `VIRTIO_BLK_S_OK` is 0 and untouched memory is 0 too.
    let mut at: size = 0B;
    while (at < SECTOR_BYTES) {
        region[data_a + at] = to_le_low(SENTINEL_A);
        region[data_b + at] = to_le_low(SENTINEL_B);
        at = at + 1B;
    }
    region[status_a] = to_le_low(STATUS_SENTINEL);
    region[status_b] = to_le_low(STATUS_SENTINEL);

    // --- both chains, at the descriptors the pool chose (§2.7.5) -------------
    //
    // Header device-readable; data device-writable; status device-writable and
    // last. Every `next` names the pool's choice, and the two chains name
    // disjoint descriptors and disjoint memory.
    write_descriptor(borrow mut region, desc_offset, chain_a[0B],
        header_a_address, 16u64, DESC_F_NEXT, chain_a[1B]);
    write_descriptor(borrow mut region, desc_offset, chain_a[1B],
        data_a_address, SECTOR_COUNT, DESC_F_WRITE | DESC_F_NEXT, chain_a[2B]);
    write_descriptor(borrow mut region, desc_offset, chain_a[2B],
        status_a_address, 1u64, DESC_F_WRITE, 0u64);
    write_descriptor(borrow mut region, desc_offset, chain_b[0B],
        header_b_address, 16u64, DESC_F_NEXT, chain_b[1B]);
    write_descriptor(borrow mut region, desc_offset, chain_b[1B],
        data_b_address, SECTOR_COUNT, DESC_F_WRITE | DESC_F_NEXT, chain_b[2B]);
    write_descriptor(borrow mut region, desc_offset, chain_b[2B],
        status_b_address, 1u64, DESC_F_WRITE, 0u64);

    // **Step 2, twice** (§2.7.13): each chain head goes into the next available
    // ring entry. §2.7.13.2's own form for more than one chain is
    // `avail->ring[(avail->idx + added++) % qsz] = head;`, which is exactly the
    // two slots below — the counter does not move between them.
    let produce_a: u64 = ring_slot(avail_idx, chosen);
    let produce_b: u64 = ring_slot(ring_next(avail_idx), chosen);
    if (produce_a == produce_b) {
        give_up(borrow mut window);
        return -82i64;
    }
    put_le16(borrow mut region, avail_offset + 4B + scale(2B, produce_a),
        chain_a[0B]);
    put_le16(borrow mut region, avail_offset + 4B + scale(2B, produce_b),
        chain_b[0B]);

    // **Nothing is exposed that is not PREPARED** — all six of them, not three.
    let mut ready: bool = true;
    let mut member: u64 = 0u64;
    while (member < CHAIN_LENGTH) {
        if (owner[slot(chain_a[slot(member)])] != DESC_PREPARED) {
            ready = false;
        }
        if (owner[slot(chain_b[slot(member)])] != DESC_PREPARED) {
            ready = false;
        }
        member = member + 1u64;
    }
    if (!ready) {
        give_up(borrow mut window);
        return -56i64;
    }
    proved = proved + PROVED_BOTH_PREPARED;

    // **And the pool is empty, here, where it is load-bearing.**
    //
    // Six slots, two chains of three: a driver that gave either chain back
    // before this point would have three free descriptors, and one that served
    // the two requests one after the other cannot reach this line with a zero
    // count whatever descriptors its allocator happened to choose. The check
    // belongs at the publication and not at the allocation — descriptors can be
    // returned to a pool in between, and a mutation that did exactly that was
    // caught four steps later by the final pool-whole check instead of here,
    // which is why it is written at the moment it actually guards.
    if (free_held != 0u64) {
        give_up(borrow mut window);
        return -81i64;
    }
    proved = proved + PROVED_POOL_EMPTY;

    // **And nothing has been consumed.** The consumer index is still where the
    // boot started it, so neither chain can have completed and been reclaimed
    // before the publication below.
    if (last_seen_used != 0u64) {
        give_up(borrow mut window);
        return -83i64;
    }
    if (avail_idx != published_before) {
        give_up(borrow mut window);
        return -84i64;
    }
    proved = proved + PROVED_NOTHING_CONSUMED;

    // **Step 4 — the first publication point.** Six descriptors, two headers,
    // 1024 bytes of poison, two status sentinels and *both* ring entries become
    // visible to the device before the marker that exposes them. §2.7.13.3.1:
    // "The driver MUST perform a suitable memory barrier before the idx update,
    // to ensure the device sees the most up-to-date copy."
    dma_publish(region);

    // Both chains stop being the driver's here, together.
    member = 0u64;
    while (member < CHAIN_LENGTH) {
        owner[slot(chain_a[slot(member)])] = DESC_DEVICE;
        owner[slot(chain_b[slot(member)])] = DESC_DEVICE;
        member = member + 1u64;
    }

    // **Step 5 — one store, and the whole claim of this stage.**
    //
    // §2.7.13 step 5: "The available idx is increased by the number of
    // descriptor chain heads added to the available ring." Two heads were
    // added, so it increases by two — once. Two stores of `+1` would be a
    // different program even with nothing between them, because §2.7.13.3 says
    // that once `avail.idx` is updated "the device MAY access the descriptor
    // chains the driver created and the memory they refer to immediately": the
    // device could legally finish request A between them, and this boot would
    // then have proved only what Stage 4D-3 proved.
    avail_idx = ring_add(avail_idx, OUTSTANDING);
    put_le16(borrow mut region, avail_offset + 2B, avail_idx);

    // The transition, checked against the counter this driver kept rather than
    // against a literal: the producer index moved by exactly the number of
    // chains that were exposed.
    //
    // **This bit does not prove the store happened once**, and it is worth
    // saying so where the check is rather than in a document. A program that
    // stored `+1` twice with nothing between them would arrive at the same
    // counter and satisfy this, and no observation a driver can make about
    // itself distinguishes the two. What the bits *above* prove is the thing
    // that matters — both chains prepared, the pool empty, nothing consumed and
    // both chains device-owned at the moment of publication — and that the
    // store is written once is a property of this source, checked mechanically
    // by the gate against the text rather than asserted by the program.
    if (ring_distance(avail_idx, published_before) != OUTSTANDING) {
        give_up(borrow mut window);
        return -85i64;
    }
    proved = proved + PROVED_PUBLICATION_ADDED_TWO;

    // Every descriptor of both chains is the device's, and none of them was
    // reclaimed on the way here.
    let mut owned: u64 = 0u64;
    member = 0u64;
    while (member < CHAIN_LENGTH) {
        if (owner[slot(chain_a[slot(member)])] == DESC_DEVICE) {
            owned = owned + 1u64;
        }
        if (owner[slot(chain_b[slot(member)])] == DESC_DEVICE) {
            owned = owned + 1u64;
        }
        member = member + 1u64;
    }
    if (owned != POOL_COUNT) {
        give_up(borrow mut window);
        return -86i64;
    }
    proved = proved + PROVED_BOTH_DEVICE_OWNED;

    // **Step 6 — the second publication point**, and it is not the same one. A
    // device may observe `avail.idx` without being notified, so the marker has
    // to be visible before the transaction that notifies it (ADR-0086 §6b).
    dma_publish(region);

    // Step 7: notify, once, for both chains. §2.7.10.1 and §2.7.7.1 make a
    // spurious notification the device's problem and a spurious wake this
    // driver's, and neither is inferred from the other.
    mmio_write_le_u16(window, notify_at, 0u64);

    // --- draining both completions, in whichever order they arrive -----------
    //
    // §2.6: a device "is not generally required to use buffers in the same
    // order in which they have been made available by the driver", and §5.2.6
    // says of block requests that "they are used by the device (not necessarily
    // in order)". `VIRTIO_F_IN_ORDER` is not negotiated, so the ring slot a
    // completion arrives in says nothing about which request it is: identity is
    // `used_elem.id`, matched against the two heads still outstanding.
    //
    // A wake is a delivery fact and not a completion (ADR-0082 §7), and one
    // wake may cover any number of completions. So each wake is followed by a
    // consume and a look at `used.idx`, and everything that became visible is
    // drained before waiting again.
    let mut seen_a: u64 = 0u64;
    let mut seen_b: u64 = 0u64;
    let mut completed: u64 = 0u64;
    let mut wakes: u64 = 0u64;
    let mut max_fresh: u64 = 0u64;
    let mut first_completed: u64 = 2u64;
    let mut content_a: u64 = 256u64;
    let mut content_b: u64 = 256u64;

    while (completed < OUTSTANDING) {
        if (wakes >= MAX_WAKES) {
            give_up(borrow mut window);
            return -87i64;
        }
        let woken: i64 = irq_wait(source);
        if (woken != OK) {
            give_up(borrow mut window);
            return woken - 600i64;
        }
        wakes = wakes + 1u64;

        // **Before any of the device's writes are read** (ADR-0086 §7). A
        // whole-region consume while a request is still outstanding is
        // visibility and not ownership: what it makes visible is what the
        // device has already written, and a chain the device still holds is
        // still the device's.
        dma_consume(region);

        let device_used: u64 = read_le16(borrow region, used_offset + 2B);
        let mut fresh: u64 = ring_distance(device_used, last_seen_used);
        if (fresh > max_fresh) {
            max_fresh = fresh;
        }

        // More used entries than this driver has chains outstanding is a device
        // reporting completions nobody asked for, and it is refused rather than
        // read out of a slot this driver never published into.
        if (fresh > (OUTSTANDING - completed)) {
            give_up(borrow mut window);
            return -57i64;
        }

        // `fresh == 0` is a spurious or early wake (§2.7.7.1): nothing became
        // visible, so nothing is consumed and the wait is repeated.
        while (fresh > 0u64) {
            let consume_at: size = used_offset + 4B
                + scale(8B, ring_slot(last_seen_used, chosen));
            let used_id: u64 = read_le32(borrow region, consume_at);
            let used_len: u64 = read_le32(borrow region, consume_at + 4B);

            // **Identity is the head, and the head names exactly one request
            // that has not completed yet.** An unknown head, or a second entry
            // naming a request already accounted for, is a refusal.
            let mut which: u64 = OUTSTANDING;
            if (used_id == chain_a[0B]) {
                if (seen_a != 0u64) {
                    give_up(borrow mut window);
                    return -88i64;
                }
                which = 0u64;
            }
            if (used_id == chain_b[0B]) {
                if (seen_b != 0u64) {
                    give_up(borrow mut window);
                    return -88i64;
                }
                which = 1u64;
            }
            if (which >= OUTSTANDING) {
                give_up(borrow mut window);
                return -58i64;
            }

            // `len` is bounded from two clauses about two parties. §2.7.8.2:
            // the device writes at least `len` bytes beginning at the first
            // device-writable buffer, and this chain's device-writable extent
            // is 512 + 1 = 513, so no conforming device can report more.
            // §2.7.8.3: the driver may not assume anything past the first `len`
            // bytes, and this driver reads all 513, so it may only do so when
            // `len` covers them.
            if (used_len > SECTOR_COUNT + 1u64) {
                give_up(borrow mut window);
                return -59i64;
            }
            if (used_len < SECTOR_COUNT + 1u64) {
                give_up(borrow mut window);
                return -60i64;
            }

            // **This request's own status byte and its own buffer.** Which one
            // is chosen by the head that completed, never by the order it
            // completed in or by the ring slot it arrived at.
            let mut data_here: size = data_a;
            let mut status_here: size = status_a;
            let mut wanted_value: u64 = expected_a;
            if (which == 1u64) {
                data_here = data_b;
                status_here = status_b;
                wanted_value = expected_b;
            }

            let status_byte: u64 = region[status_here] as u64;
            if (status_byte != BLK_S_OK) {
                give_up(borrow mut window);
                return -61i64;
            }

            // Every one of the 512 bytes is this sector's content. Not "not the
            // poison": the other request's sector is a different byte, so
            // neither request's buffer can be satisfied by the other's result,
            // and untouched memory is a third value again.
            let wanted: u8 = to_le_low(wanted_value);
            let mut checked: size = 0B;
            let mut exact: bool = true;
            while (checked < SECTOR_BYTES) {
                if (region[data_here + checked] != wanted) {
                    exact = false;
                    checked = SECTOR_BYTES;
                }
                if (checked < SECTOR_BYTES) {
                    checked = checked + 1B;
                }
            }
            if (!exact) {
                give_up(borrow mut window);
                return -62i64;
            }

            // **Reclaim exactly this request's three descriptors**, and only
            // after a used entry named its chain. Two passes, because the two
            // transitions are different facts: the first says the used entry
            // ended the device's ownership of every member, the second puts
            // them back where the allocator can find them.
            let mut back: u64 = 0u64;
            let mut settled: bool = true;
            while (back < CHAIN_LENGTH) {
                let mut returning: u64 = chain_a[slot(back)];
                if (which == 1u64) {
                    returning = chain_b[slot(back)];
                }
                if (owner[slot(returning)] != DESC_DEVICE) {
                    settled = false;
                }
                owner[slot(returning)] = DESC_COMPLETED;
                back = back + 1u64;
            }
            if (!settled) {
                give_up(borrow mut window);
                return -63i64;
            }
            back = 0u64;
            while (back < CHAIN_LENGTH) {
                let mut returning: u64 = chain_a[slot(back)];
                if (which == 1u64) {
                    returning = chain_b[slot(back)];
                }
                owner[slot(returning)] = DESC_FREE;
                freeq[(free_front + scale(1B, free_held)) % POOL_SLOTS] = returning;
                free_held = free_held + 1u64;
                back = back + 1u64;
            }

            // The other request's descriptors are untouched by this reclaim: if
            // it has not completed yet, every one of them is still the device's.
            if (completed + 1u64 < OUTSTANDING) {
                let mut still: u64 = 0u64;
                member = 0u64;
                while (member < CHAIN_LENGTH) {
                    let mut other: u64 = chain_b[slot(member)];
                    if (which == 1u64) {
                        other = chain_a[slot(member)];
                    }
                    if (owner[slot(other)] == DESC_DEVICE) {
                        still = still + 1u64;
                    }
                    member = member + 1u64;
                }
                if (still != CHAIN_LENGTH) {
                    give_up(borrow mut window);
                    return -89i64;
                }
            }

            if (which == 0u64) {
                seen_a = 1u64;
                content_a = region[data_a] as u64;
            }
            if (which == 1u64) {
                seen_b = 1u64;
                content_b = region[data_b] as u64;
            }
            if (first_completed >= OUTSTANDING) {
                first_completed = which;
            }

            // **The consumer index advances once per entry consumed**, not once
            // per wake, and only after the entry has been read (§2.7.14).
            last_seen_used = ring_next(last_seen_used);
            completed = completed + 1u64;
            fresh = fresh - 1u64;
        }
    }

    // --- what held for both completions --------------------------------------
    //
    // A completion that failed any check above returned a negative naming it,
    // so reaching here with both accounted for is what makes these bits "for
    // both requests, in whichever order they arrived".
    if (completed != OUTSTANDING) {
        give_up(borrow mut window);
        return -65i64;
    }
    if (seen_a != 1u64) {
        give_up(borrow mut window);
        return -90i64;
    }
    if (seen_b != 1u64) {
        give_up(borrow mut window);
        return -91i64;
    }
    proved = proved + PROVED_USED_ID_MATCHED + PROVED_LEN_COVERS_REQUEST
        + PROVED_STATUS_OK + PROVED_CHAIN_RECLAIMED;

    // The two buffers hold two different sectors' contents, which no single
    // device write could have produced and no shared buffer could have shown.
    if (content_a == content_b) {
        give_up(borrow mut window);
        return -70i64;
    }
    if (content_a != expected_a) {
        give_up(borrow mut window);
        return -92i64;
    }
    if (content_b != expected_b) {
        give_up(borrow mut window);
        return -93i64;
    }
    proved = proved + PROVED_SECTORS_READ;

    // --- and what held across the pair ---------------------------------------
    if (avail_idx != OUTSTANDING) {
        give_up(borrow mut window);
        return -66i64;
    }
    if (last_seen_used != OUTSTANDING) {
        give_up(borrow mut window);
        return -67i64;
    }

    // **The pool is whole again**, and by the same test it started with: every
    // descriptor free, and named exactly once by the free queue. An
    // order-independent check, because the free queue's order after two
    // reclaims depends on which request completed first.
    if (free_held != POOL_COUNT) {
        give_up(borrow mut window);
        return -64i64;
    }
    let mut back_seen: array<u64, 6> = [0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
    scan = 0u64;
    while (scan < POOL_COUNT) {
        let named: u64 = freeq[slot(scan)];
        if (named < POOL_COUNT) {
            back_seen[slot(named)] = back_seen[slot(named)] + 1u64;
        }
        scan = scan + 1u64;
    }
    let mut whole: bool = true;
    scan = 0u64;
    while (scan < POOL_COUNT) {
        if (back_seen[slot(scan)] != 1u64) {
            whole = false;
        }
        if (owner[slot(scan)] != DESC_FREE) {
            whole = false;
        }
        scan = scan + 1u64;
    }
    if (!whole) {
        give_up(borrow mut window);
        return -94i64;
    }

    // --- the report -----------------------------------------------------------
    //
    // Every field is bounded here before it is packed, so none can reach into
    // the next and the whole value stays inside `i64`.
    let head_a: u64 = chain_a[0B];
    let head_b: u64 = chain_b[0B];
    if (avail_idx > AVAIL_LIMIT) {
        give_up(borrow mut window);
        return -71i64;
    }
    if (last_seen_used > USED_LIMIT) {
        give_up(borrow mut window);
        return -72i64;
    }
    if (head_a > HEAD_LIMIT) {
        give_up(borrow mut window);
        return -73i64;
    }
    if (head_b > HEAD_LIMIT) {
        give_up(borrow mut window);
        return -74i64;
    }
    if (first_completed > ORDER_LIMIT) {
        give_up(borrow mut window);
        return -95i64;
    }
    if (wakes > WAKES_LIMIT) {
        give_up(borrow mut window);
        return -96i64;
    }
    if (max_fresh > FRESH_LIMIT) {
        give_up(borrow mut window);
        return -97i64;
    }
    if (chosen > QUEUE_LIMIT) {
        give_up(borrow mut window);
        return -76i64;
    }
    if (proved != PROVED_ALL) {
        give_up(borrow mut window);
        return -77i64;
    }
    let total: u64 = proved
        + avail_idx * AVAIL_SHIFT
        + last_seen_used * USED_SHIFT
        + head_a * HEAD_A_SHIFT
        + head_b * HEAD_B_SHIFT
        + first_completed * ORDER_SHIFT
        + wakes * WAKES_SHIFT
        + max_fresh * FRESH_SHIFT
        + chosen * QUEUE_SHIFT;
    match (to_i64(total)) {
        Ok(value) => { return value; }
        Err(bad) => { return -78i64; }
    }
}

// The whole boot.
pub fn main() -> i64
    uses [device, budget, platform.pci.FunctionConfig, platform.irq.Source,
          platform.dma.Region]
{
    match (pci_function_claim(device, 1u64, 0u64, 0u64)) {
        Ok(function) => {
            let cap_at: u64 = common_capability(function);
            if (cap_at == 0u64) {
                return -1i64;
            }
            let bar: u64 = byte_at(function, cap_at + CAP_BAR);
            let offset: u64 = dword_at(function, cap_at + CAP_OFFSET);
            let length: u64 = dword_at(function, cap_at + CAP_LENGTH);
            if (bar > 5u64) {
                return -2i64;
            }
            if (offset != PROFILE_COMMON_OFFSET) {
                return -3i64;
            }
            if (length < COMMON_CFG_USED) {
                return -4i64;
            }

            // **Where to notify, discovered rather than assumed.** The
            // capability is validated before its extra field is read.
            let notify_at_cap: u64 = notify_capability(function);
            if (notify_at_cap == 0u64) {
                return -5i64;
            }
            if (byte_at(function, notify_at_cap + CAP_LENGTH_BYTE) < NOTIFY_CAP_BYTES) {
                return -6i64;
            }
            // One window serves both structures, so they must be in one BAR.
            if (byte_at(function, notify_at_cap + CAP_BAR) != bar) {
                return -7i64;
            }
            let notify_offset: u64 = dword_at(function, notify_at_cap + CAP_OFFSET);
            let notify_length: u64 = dword_at(function, notify_at_cap + CAP_LENGTH);
            let multiplier: u64 = dword_at(function, notify_at_cap + CAP_NOTIFY_MULTIPLIER);

            match (pci_bar_map_write(function, bar, 0B, WINDOW_BYTES)) {
                Ok(window) => {
                    let ready: i64 = negotiate(borrow mut window);
                    if (ready != OK) {
                        return ready;
                    }
                    // **Which branch of §4.1.4.4.1 applies is the device's to
                    // decide, and it decides it by offering the feature or
                    // not** — never by what this driver went on to negotiate.
                    let offered: u64 = offered_high_dword(borrow mut window);
                    let mut notification_data: bool = false;
                    if ((offered & NOTIFICATION_DATA_IN_HIGH_DWORD) != 0u64) {
                        notification_data = true;
                    }
                    let mut wanted_alignment: u64 = 2u64;
                    let mut wanted_room: u64 = 2u64;
                    if (notification_data) {
                        wanted_alignment = 4u64;
                        wanted_room = 4u64;
                    }

                    // "The cap.offset MUST be 2-byte aligned" — or 4-byte, on
                    // the other branch. **Of `cap.offset` itself**, as the
                    // clause states it.
                    if ((notify_offset % wanted_alignment) != 0u64) {
                        give_up(borrow mut window);
                        return -15i64;
                    }
                    if (!multiplier_admitted(multiplier, notification_data)) {
                        give_up(borrow mut window);
                        return -16i64;
                    }

                    // `queue_notify_off` belongs to the queue, so it is read
                    // after selecting it (§4.1.4.4).
                    mmio_write_le_u16(window, QUEUE_SELECT, 0u64);
                    let notify_off: u64 = mmio_read_le_u16(window, QUEUE_NOTIFY_OFF);
                    // §4.1.4.4.1: `cap.length >= queue_notify_off * multiplier`
                    // plus 2 on the not-offering branch and 4 on the other.
                    let within: u64 = notify_off * multiplier;
                    if (notify_length < within + wanted_room) {
                        give_up(borrow mut window);
                        return -8i64;
                    }
                    // §4.1.4.4: Queue Notify = cap.offset + queue_notify_off *
                    // notify_off_multiplier. Bounded by this driver's own window
                    // before it is allowed into the `size` domain.
                    let notify_address: u64 = notify_offset + within;
                    if (notify_address + wanted_room > WINDOW_LIMIT) {
                        give_up(borrow mut window);
                        return -9i64;
                    }
                    if ((notify_address % wanted_alignment) != 0u64) {
                        give_up(borrow mut window);
                        return -10i64;
                    }
                    let notify_at: size = window_offset(notify_address);
                    match (dma_region_allocate(function, budget, REGION_BYTES)) {
                        Ok(region) => {
                            match (pci_interrupt_claim(function, QUEUE_ENTRY)) {
                                Ok(source) => {
                                    return drive(borrow mut window, region, source,
                                        notify_at);
                                }
                                Err(status) => {
                                    give_up(borrow mut window);
                                    return status - 330i64;
                                }
                            }
                        }
                        Err(status) => {
                            give_up(borrow mut window);
                            return status - 100i64;
                        }
                    }
                }
                Err(status) => {
                    return status - 200i64;
                }
            }
        }
        Err(status) => {
            return status - 400i64;
        }
    }
}
