// SPDX-License-Identifier: GPL-3.0-or-later
//
// The supervisor of the endpoint-attenuation boot: two children, two endpoints,
// and no hardware anywhere.
//
//   the holder is created with `send | receive` on `link` and `send` on `channel`
//   the peer is created with `receive` on `channel` and nothing else
//   both endings are collected (ADR-0067, operation 14)
//
// **The topology is the claim's setting and nothing more.** ADR-0100 is about a
// process making a send-only name for an endpoint it receives on; the only thing a
// second process is needed for is to be handed one. So: one endpoint the holder owns
// (`link`), one channel to hand the alias over on (`channel`), and no device, no
// region and no registry.
//
// **Every receiving name is let go before the child that receives on it exists.**
// `IPC_V1` §2 admits one receive-rights holder at a time and the nucleus enforces it
// at creation: a launcher still holding `receive` cannot endow it, and the creation
// is refused whole (ADR-0055) rather than half-endowed.

module system.boot.init version 1.5 profile full;

import capability system.process.Control as process;
import capability system.memory.Authority as memory;
import capability system.ipc.Endpoint as link_full;
import capability system.ipc.Endpoint as channel_full;

resource [
    fuel: 262144,
    stack: 16KiB,
    allocation: 8KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 0,
    recursion: 16,
    imports: 12
]

extern fn launch_plan_create(
    cap: system.process.Control
) -> Result<system.process.LaunchPlanBuilder, i64> uses [process];

extern fn endow_for_launch(
    held: system.ipc.Endpoint,
    plan: system.process.LaunchPlanBuilder,
    rights: u64,
    binding: string
) -> i64 uses [system.ipc.Endpoint];

extern fn endow_for_launch(
    held: system.memory.Authority,
    plan: system.process.LaunchPlanBuilder,
    rights: u64,
    binding: string
) -> i64 uses [memory];

extern fn launch_plan_seal(
    cap: system.process.Control,
    plan: system.process.LaunchPlanBuilder
) -> Result<system.process.LaunchPlan, i64> uses [process];

extern fn process_create_funded(
    cap: system.process.Control,
    funding: system.memory.Authority,
    plan: system.process.LaunchPlan,
    entry: string,
    grant: u64,
    self_rights: u64
) -> Result<system.process.CreatedProcess, i64> uses [process, memory];

extern fn process_wait_child(
    cap: system.process.Control, flags: u64
) -> Result<system.process.ChildEnding, i64> uses [process];

extern fn capability_release(
    cap: system.process.Control
) -> i64 uses [process];

extern fn capability_release(
    cap: system.ipc.Endpoint
) -> i64 uses [system.ipc.Endpoint];

const OK: i64 = 0i64;
const RIGHT_SEND: u64 = 1u64;
const RIGHT_RECEIVE: u64 = 2u64;
const RIGHT_SPEND: u64 = 128u64;
const BLOCKING: u64 = 0u64;
const NO_SELF_RIGHTS: u64 = 0u64;
const CHILD_GRANT: u64 = 8388608u64;

const CREATED_HOLDER: i64 = 1i64;
const CREATED_PEER: i64 = 2i64;
const FIRST_ENDING: i64 = 4i64;
const SECOND_ENDING: i64 = 8i64;

// The holder: the endpoint it owns, and a way to reach the peer.
//
// **The budget comes first and is used for nothing.** The runtime image exercises a
// process's first endowed capability after `main` returns, and for an endpoint
// carrying `receive` that exercise is a blocking receive — which would leave this
// child blocked in its own epilogue, counted by the liveness census, instead of
// ended and collected. A memory authority's exercise blocks on nothing. That is the
// endowment's whole purpose and it is stated rather than left to be inferred.
fn holder_plan() -> Result<system.process.LaunchPlan, i64>
    uses [process, memory, link_full, channel_full, system.ipc.Endpoint]
{
    match (launch_plan_create(process)) {
        Ok(builder) => {
            if (endow_for_launch(memory, builder, RIGHT_SPEND, "budget") != OK) {
                return Err(-2001i64);
            }
            if (endow_for_launch(link_full, builder,
                RIGHT_SEND | RIGHT_RECEIVE, "link") != OK) {
                return Err(-2002i64);
            }
            // `send` alone: the holder puts the alias on this channel and never
            // takes anything off it.
            if (endow_for_launch(channel_full, builder, RIGHT_SEND, "channel") != OK) {
                return Err(-2003i64);
            }
            return launch_plan_seal(process, builder);
        }
        Err(unplanned) => { return Err(unplanned - 2200i64); }
    }
}

// The peer: one way to be handed something, and nothing else at all.
//
// **It holds no name for `link`.** Whatever it comes to hold for that endpoint, it
// was given in a message — which is what makes its two assertions about the alias
// assertions about the alias and not about its own endowment.
fn peer_plan() -> Result<system.process.LaunchPlan, i64>
    uses [process, memory, channel_full, system.ipc.Endpoint]
{
    match (launch_plan_create(process)) {
        Ok(builder) => {
            if (endow_for_launch(memory, builder, RIGHT_SPEND, "budget") != OK) {
                return Err(-3001i64);
            }
            if (endow_for_launch(channel_full, builder, RIGHT_RECEIVE, "channel") != OK) {
                return Err(-3002i64);
            }
            return launch_plan_seal(process, builder);
        }
        Err(unplanned) => { return Err(unplanned - 3200i64); }
    }
}

fn start(plan: system.process.LaunchPlan, entry: string) -> i64
    uses [process, memory]
{
    match (process_create_funded(process, memory, plan, entry, CHILD_GRANT,
        NO_SELF_RIGHTS)) {
        Ok(child) => {
            if (capability_release(child.control) != OK) { return -9001i64; }
            return OK;
        }
        Err(uncreated) => { return uncreated; }
    }
}

pub fn main() -> i64
    uses [process, memory, link_full, channel_full, system.ipc.Endpoint]
{
    let mut found: i64 = 0i64;

    match (holder_plan()) {
        Ok(holder) => {
            match (peer_plan()) {
                Ok(peer) => {
                    if (capability_release(link_full) != OK) { return -8001i64; }
                    if (capability_release(channel_full) != OK) { return -8002i64; }

                    // **The peer first.** It blocks on its receive until the holder
                    // hands the alias over, so either order works; creating it
                    // first is how the journal reads in the order the claim is made.
                    if (start(peer, "system/test/peer.tos") != OK) { return -1i64; }
                    found = found + CREATED_PEER;
                    if (start(holder, "system/test/holder.tos") != OK) { return -2i64; }
                    found = found + CREATED_HOLDER;
                }
                Err(unplanned) => { return unplanned - 20i64; }
            }
        }
        Err(unplanned) => { return unplanned - 10i64; }
    }

    match (process_wait_child(process, BLOCKING)) {
        Ok(first) => { found = found + FIRST_ENDING; }
        Err(refused) => { return refused - 30i64; }
    }
    match (process_wait_child(process, BLOCKING)) {
        Ok(second) => { found = found + SECOND_ENDING; }
        Err(refused) => { return refused - 40i64; }
    }
    return found;
}
