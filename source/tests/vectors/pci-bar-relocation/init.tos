// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4C-1: a claimed function's resource placement cannot be moved.
//
// ADR-0082 §5a. ADR-0081 §13 measures each BAR once, at claim time, and every
// later mapping derives its physical base from that cached measurement; §4 of
// ADR-0082 maps the MSI-X table the same way, and §5 computes its extent from a
// cached BIR. All three assume the cached layout stays the layout the live
// function decodes.
//
// **This module was written as an audit and reported that the assumption was
// false**: BAR1 — the MSI-X table's own BAR — accepted a CPL-3 write, as did
// both halves of the 64-bit BAR4 pair, and a window was still derived from the
// stale cached base afterwards. It is now the negative gate for the narrowing
// that closed it.
//
// Each register is written with all-ones and read back — the same probe the
// nucleus itself performs when sizing, so nothing here is a write the device has
// not already seen. A bit set means the register **accepted the write**, so a
// passing run reports zero for every placement register.

module system.boot.init version 1.2 profile full;

import capability platform.pci.Bus as bus;

resource [
    fuel: 262144, stack: 32KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 0, recursion: 16, imports: 4
]

extern fn pci_function_claim(
    cap: platform.pci.Bus, bus_number: u64, device: u64, function: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [bus];

extern fn pci_config_read(
    cap: platform.pci.FunctionConfig, offset: u64, width: u64
) -> Result<u64, i64> uses [platform.pci.FunctionConfig];

extern fn pci_config_write(
    cap: platform.pci.FunctionConfig, offset: u64, width: u64, value: u64
) -> i64 uses [platform.pci.FunctionConfig];

extern fn pci_bar_map_read(
    cap: platform.pci.FunctionConfig, bar: u64, offset: size, length: size
) -> Result<MmioRegion, i64> uses [platform.pci.FunctionConfig];

const ALL_ONES: u64 = 4294967295u64;
// BAR0 lives here and each register is four bytes wide.
const BAR0: u64 = 16u64;
// The expansion ROM base address register of a Type-0 header.
const EXPANSION_ROM: u64 = 48u64;
// The header type register. Bit 7 says multi-function; the low bits say which
// layout the rest of the header has, and a Type-1 puts its resource registers
// somewhere else entirely.
const HEADER_TYPE: u64 = 14u64;

fn read_at(function: platform.pci.FunctionConfig, offset: u64, width: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    match (pci_config_read(function, offset, width)) {
        Ok(value) => { return value; }
        Err(status) => { return 4294967296u64; }
    }
}

// Whether one four-byte register accepts a write from CPL 3.
//
// Writes all-ones, reads back, restores. A register the nucleus protects answers
// `E_NO_CAPABILITY` and reads back unchanged; one it does not protect reports
// something other than what it held.
fn accepts_write(function: platform.pci.FunctionConfig, offset: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    let original: u64 = read_at(function, offset, 4u64);
    let status: i64 = pci_config_write(function, offset, 4u64, ALL_ONES);
    if (status != 0i64) {
        return 0u64;
    }
    let probed: u64 = read_at(function, offset, 4u64);
    let restore: i64 = pci_config_write(function, offset, 4u64, original);
    let back: u64 = read_at(function, offset, 4u64);
    // The write took effect only if the register actually changed *and* the
    // original went back. A register that never changed is one the device holds
    // read-only, which is not the same as one the nucleus protects.
    if (probed == original) {
        return 0u64;
    }
    if (back != original) {
        return 0u64;
    }
    return 1u64;
}

//   1  BAR0     2  BAR1     4  BAR2     8  BAR3    16  BAR4    32  BAR5
//  64  the expansion ROM base address register
// 128  a window could still be derived after BAR4 had been rewritten — the
//      defect this gate exists to keep closed
//
// and three bits that must be **set**, because a rule that refused everything
// would prove nothing about what it protects:
//
// 512  writing a placement register back unchanged is still permitted
//1024  a window on BAR4 still derives the original measured extent
//2048  an ordinary unrelated writable field is still writable
pub fn main() -> i64 uses [bus, platform.pci.FunctionConfig] {
    match (pci_function_claim(bus, 0u64, 4u64, 0u64)) {
        Ok(function) => {
            let mut found: i64 = 0i64;
            // Recorded so the finding is scoped honestly: the offsets below are
            // a Type-0 header's, and a Type-1 header puts bridge windows and its
            // expansion ROM elsewhere.
            let header: u64 = read_at(function, HEADER_TYPE, 1u64);

            if (accepts_write(function, BAR0) == 1u64) { found = found + 1i64; }
            if (accepts_write(function, BAR0 + 4u64) == 1u64) { found = found + 2i64; }
            if (accepts_write(function, BAR0 + 8u64) == 1u64) { found = found + 4i64; }
            if (accepts_write(function, BAR0 + 12u64) == 1u64) { found = found + 8i64; }
            if (accepts_write(function, BAR0 + 16u64) == 1u64) { found = found + 16i64; }
            if (accepts_write(function, BAR0 + 20u64) == 1u64) { found = found + 32i64; }
            if (accepts_write(function, EXPANSION_ROM) == 1u64) { found = found + 64i64; }

            // The consequence, not merely the ability. BAR4 is rewritten, and
            // the nucleus is then asked for a window on BAR4. Before the
            // narrowing it produced one, derived from the base it cached at
            // claim time — a physical range the function no longer answered for.
            let bar4: u64 = read_at(function, BAR0 + 16u64, 4u64);
            let moved: i64 = pci_config_write(function, BAR0 + 16u64, 4u64, ALL_ONES);
            if (moved == 0i64) {
                match (pci_bar_map_read(function, 4u64, 0B, 4096B)) {
                    Ok(window) => { found = found + 128i64; }
                    Err(status) => { }
                }
            }
            let put_back: i64 = pci_config_write(function, BAR0 + 16u64, 4u64, bar4);

            // 512: writing back what is already there changes nothing, so it is
            // permitted. Without this the narrowing could be a blanket refusal
            // of the register and nobody would be able to tell.
            if (pci_config_write(function, BAR0 + 16u64, 4u64, bar4) == 0i64) {
                found = found + 512i64;
            }

            // 1024: and the window still comes out where it was measured. This
            // is the property §5a exists to preserve, and it does not follow
            // from the refusal on its own — a nucleus that refused the write and
            // had already lost the base would fail here and pass above.
            match (pci_bar_map_read(function, 4u64, 0B, 4096B)) {
                Ok(window) => { found = found + 1024i64; }
                Err(status) => { }
            }

            // 2048: an ordinary field that is nobody's but the driver's. The
            // cache line size register is writable, is not placement, is not
            // routing, and is not an interrupt structure.
            let cache_line: u64 = read_at(function, 12u64, 1u64);
            if (pci_config_write(function, 12u64, 1u64, cache_line) == 0i64) {
                found = found + 2048i64;
            }

            // The header type travels out with the result, so the report can say
            // which layout these offsets were read under.
            if (header % 128u64 == 0u64) {
                return found + 256i64;
            }
            return found;
        }
        Err(status) => { return status - 1000i64; }
    }
}
