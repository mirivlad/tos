// SPDX-License-Identifier: GPL-3.0-or-later
//
// Stage 4C-1: conventional MSI is nucleus-owned interrupt routing too.
//
// ADR-0082 §5c. The authority rule is about **interrupts**, not about a
// transport: an interrupt is reached through the live assignment and through
// nothing else. A device offering conventional MSI would otherwise offer an
// ambient route around `platform.irq.Source` — the same escalation §5 closes for
// MSI-X, through a different capability.
//
// The Stage 4 reference VirtIO function has no MSI capability, so this module
// claims a function of the **same reference machine** that does: the q35
// chipset's own SATA controller at 00:1f.2, whose MSI capability sits at 0x80
// with a 64-bit message address and no per-vector masking. Nothing is invented
// and no MSI delivery path is built — a refusal needs no backend.
//
// The module finds the capability by walking the list, so the nucleus and the
// module agree about where it is or the evidence fails.

module system.boot.init version 1.2 profile full;

import capability platform.pci.Bus as bus;

resource [
    fuel: 262144, stack: 32KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 0, recursion: 16, imports: 4
]

extern fn pci_function_claim(
    cap: platform.pci.Bus, bus_number: u64, device: u64, function: u64
) -> Result<platform.pci.FunctionConfig, i64> uses [bus];

extern fn pci_config_read(
    cap: platform.pci.FunctionConfig, offset: u64, width: u64
) -> Result<u64, i64> uses [platform.pci.FunctionConfig];

extern fn pci_config_write(
    cap: platform.pci.FunctionConfig, offset: u64, width: u64, value: u64
) -> i64 uses [platform.pci.FunctionConfig];

const E_NO_CAPABILITY: i64 = -1i64;
const OK: i64 = 0i64;

const MAX_CAPABILITIES: u64 = 64u64;
const FIRST_CAPABILITY: u64 = 64u64;
const LAST_CAPABILITY: u64 = 240u64;
const CAPABILITY_POINTER: u64 = 52u64;
const CAP_ID_MSI: u64 = 5u64;
// The cache line size register: writable, ordinary, and nobody's but the
// driver's. The control that keeps the refusals below from being a blanket.
const CACHE_LINE_SIZE: u64 = 12u64;

fn read_at(function: platform.pci.FunctionConfig, offset: u64, width: u64) -> u64
    uses [platform.pci.FunctionConfig]
{
    match (pci_config_read(function, offset, width)) {
        Ok(value) => { return value; }
        Err(status) => { return 4294967296u64; }
    }
}

fn is(status: i64, expected: i64, bit: i64) -> i64 {
    if (status == expected) { return bit; }
    return 0i64;
}

fn msi_capability(function: platform.pci.FunctionConfig) -> u64
    uses [platform.pci.FunctionConfig]
{
    let mut at: u64 = read_at(function, CAPABILITY_POINTER, 1u64);
    let mut steps: u64 = 0u64;
    let mut found: u64 = 256u64;
    while (steps < MAX_CAPABILITIES) {
        if (at < FIRST_CAPABILITY) {
            steps = MAX_CAPABILITIES;
        }
        if (steps < MAX_CAPABILITIES) {
            if (at > LAST_CAPABILITY) {
                steps = MAX_CAPABILITIES;
            }
        }
        if (steps < MAX_CAPABILITIES) {
            if (read_at(function, at, 1u64) == CAP_ID_MSI) {
                found = at;
                steps = MAX_CAPABILITIES;
            }
            if (steps < MAX_CAPABILITIES) {
                at = read_at(function, at + 1u64, 1u64);
                steps = steps + 1u64;
            }
        }
    }
    return found;
}

//   1  a write to the MSI Message Control is refused
//   2  a write to the MSI Message Address is refused
//   4  a write to the MSI Message Data is refused
//   8  reading the capability still works — a fact is not authority
//  16  an ordinary unrelated field is still writable
//  32  MSI Enable is off when CPL 3 first sees the function
pub fn main() -> i64 uses [bus, platform.pci.FunctionConfig] {
    match (pci_function_claim(bus, 0u64, 31u64, 2u64)) {
        Ok(function) => {
            let cap_at: u64 = msi_capability(function);
            if (cap_at > LAST_CAPABILITY) {
                // Without an MSI capability every refusal below is vacuous, so
                // this is reported as its own failure rather than as a pass.
                return -2i64;
            }
            let mut found: i64 = 0i64;

            // Each write puts back the value already there, so a nucleus that
            // permitted them would change nothing: the refusal is about the
            // structure, not about the value.
            let control: u64 = read_at(function, cap_at + 2u64, 2u64);
            found = found + is(
                pci_config_write(function, cap_at + 2u64, 2u64, control),
                E_NO_CAPABILITY, 1i64);

            let address: u64 = read_at(function, cap_at + 4u64, 4u64);
            found = found + is(
                pci_config_write(function, cap_at + 4u64, 4u64, address),
                E_NO_CAPABILITY, 2i64);

            // With a 64-bit message address the data word sits at +12; with a
            // 32-bit one it sits at +8. Bit 7 of Message Control says which, so
            // the module derives it exactly as the nucleus does.
            let mut data_at: u64 = cap_at + 8u64;
            if (control % 256u64 >= 128u64) {
                data_at = cap_at + 12u64;
            }
            let data: u64 = read_at(function, data_at, 2u64);
            found = found + is(
                pci_config_write(function, data_at, 2u64, data),
                E_NO_CAPABILITY, 4i64);

            // 8: the capability is still readable.
            if (read_at(function, cap_at, 1u64) == CAP_ID_MSI) {
                found = found + 8i64;
            }

            // 16: and the narrowing is a narrowing.
            let cache_line: u64 = read_at(function, CACHE_LINE_SIZE, 1u64);
            found = found + is(
                pci_config_write(function, CACHE_LINE_SIZE, 1u64, cache_line),
                OK, 16i64);

            // 32: the claim disabled it before this module could see it.
            if (control % 2u64 == 0u64) {
                found = found + 32i64;
            }

            return found;
        }
        Err(status) => { return status - 100i64; }
    }
}
