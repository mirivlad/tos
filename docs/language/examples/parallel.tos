module examples.parallel version 1.0 profile bootstrap;

resource {
    fuel: 100000;
    stack: 64KiB;
    allocation: 8KiB;
    tasks: 2;
    workers: 1;
    sync: 0;
    shared: 0B;
    cleanup: 32;
    recursion: 8;
    imports: 0;
}

pub fn sum_range(begin: i32, end: i32) -> i32 {
    let mut value = begin;
    let mut total = 0i32;
    while value < end {
        total = total + value;
        value = value + 1i32;
    }
    total
}

pub fn paired_sum() -> i32 {
    let mut total = 0i32;
    parallel {
        let left = spawn parallel { sum_range(0i32, 10i32) };
        let right = spawn parallel { sum_range(10i32, 20i32) };
        let left_total = join left;
        let right_total = join right;
        total = left_total + right_total;
    }
    total
}
