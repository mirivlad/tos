module examples.capabilities version 1.0 profile bootstrap;

import capability system.time.Clock as clock;

resource [
    fuel: 10000,
    stack: 64KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 16,
    recursion: 8,
    imports: 1,
]

// This example is only about requesting authority and declaring its effect.
// A capability is not a callable object: real system operations are reached
// through an accepted interface schema (`extern fn`), as SYSTEM_INTERFACE_V1
// demonstrates. `system.time.Clock` has no accepted service schema yet.
fn inspect(borrow cap: system.time.Clock) -> unit { }

pub fn sample() -> unit uses [clock] {
    inspect(borrow clock);
}
