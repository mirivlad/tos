module examples.counter_service version 1.0 profile bootstrap;

import capability system.audit.Logger as logger;

resource [
    fuel: 50000,
    stack: 64KiB,
    allocation: 8KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 16,
    recursion: 8,
    imports: 1,
]

pub record Counter [
    value: u32,
]

pub enum CounterError [
    Overflow,
]

pub fn increment(counter: Counter) -> Result<Counter, CounterError> uses [logger] {
    let next = counter.value + 1u32;
    logger.notice("counter incremented");
    return Ok(Counter(value: next));
}
