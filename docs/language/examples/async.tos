module examples.async version 1.0 profile full;

resource [
    fuel: 100000,
    stack: 64KiB,
    allocation: 8KiB,
    tasks: 2,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 32,
    recursion: 8,
    imports: 0,
]

async fn add_one(value: i32) -> i32 {
    return value + 1i32;
}

enum AsyncError [
    ChildCancelled,
]

async fn main() -> Result<i32, AsyncError> {
    let pending = spawn async {
        return 42i32;
    };
    match (await pending) {
        Completed(value) => {
            return Ok(value);
        }
        Cancelled => {
            return Err(ChildCancelled);
        }
    }
}
