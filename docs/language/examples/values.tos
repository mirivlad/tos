module examples.values version 1.0 profile bootstrap;

resource [
    fuel: 10000,
    stack: 64KiB,
    allocation: 4KiB,
    tasks: 1,
    workers: 1,
    sync: 0,
    shared: 0B,
    cleanup: 16,
    recursion: 8,
    imports: 0,
]

pub fn budget() -> size {
    let mut used: size = 4KiB;
    used = used + 512B;
    return used;
}

pub fn retry_delay() -> duration {
    return 250ms;
}
