module conformance.visibility_imported_surface version 1.0 profile bootstrap;

import conformance.visibility_exported_surface as upstream;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 1]

// The imported type is exported by its own module, so naming it in a public
// signature here is reachable for this module's consumers too.
pub fn relay(reading: upstream.Reading) -> upstream.Reading {
    return upstream.observe(reading);
}
