module conformance.bootstrap_parallel version 1.0 profile bootstrap;

resource [
    fuel: 100000, stack: 64KiB, allocation: 8KiB, tasks: 2, workers: 1,
    sync: 0, shared: 0B, cleanup: 32, recursion: 8, imports: 0,
]

pub fn sum(begin: i32, end: i32) -> i32 {
    let mut current = begin;
    let mut total = 0i32;
    while (current < end) {
        total = total + current;
        current = current + 1i32;
    }
    return total;
}

pub enum ParallelError [
    ChildCancelled,
]

pub fn completed(result: TaskResult<i32>) -> Result<i32, ParallelError> {
    match (result) {
        Completed(value) => { return Ok(value); }
        Cancelled => { return Err(ChildCancelled); }
    }
}

pub fn main() -> Result<i32, ParallelError> {
    let mut total = 0i32;
    parallel {
        let left = spawn parallel { return sum(0i32, 10i32); };
        let right = spawn parallel { return sum(10i32, 20i32); };
        total = completed(join left)? + completed(join right)?;
    }
    return Ok(total);
}
