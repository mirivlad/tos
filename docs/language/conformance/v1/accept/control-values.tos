module conformance.control_values version 1.0 profile bootstrap;

resource {
    fuel: 10000;
    stack: 64KiB;
    allocation: 4KiB;
    tasks: 1;
    workers: 1;
    sync: 0;
    shared: 0B;
    cleanup: 16;
    recursion: 8;
    imports: 0;
}

enum Signal {
    Low,
    High,
}

pub fn let_if(ready: bool) -> i32 {
    let value = if (ready) { 1i32 } else { 2i32 };
    value
}

pub fn tail_if(ready: bool) -> i32 {
    if (ready) { 3i32 } else { 4i32 }
}

pub fn let_match(signal: Signal) -> i32 {
    let value = match (signal) {
        Low => 5i32,
        High => 6i32,
    };
    value
}

pub fn tail_match(signal: Signal) -> i32 {
    match (signal) {
        Low => 7i32,
        High => 8i32,
    }
}

pub fn discarded_statement_position(ready: bool, signal: Signal) -> unit {
    if (ready) { }
    match (signal) {
        Low => {},
        High => {},
    }
}
