module conformance.named_enum_variant version 1.0 profile bootstrap;

resource [
    fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

pub enum Color [
    Rgb [
        red: u8,
        green: u8,
        blue: u8,
    ],
]

pub fn primary() -> Color {
    return Rgb(red: 255u8, green: 0u8, blue: 0u8);
}
