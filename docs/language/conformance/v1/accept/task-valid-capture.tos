module conformance.task_valid_capture version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub record Message [payload: bytes]

// The task captures the owned affine value, which transfers its sole
// ownership, and the Copy value, which is duplicated. `message` is therefore
// not used again here; `count` still is.
pub fn main(count: i32, message: Message) -> i32 {
    let worker: Task<Message> = spawn parallel {
        return message;
    };
    let outcome: TaskResult<Message> = join worker;
    return count;
}
