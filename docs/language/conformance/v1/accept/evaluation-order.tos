module conformance.evaluation_order version 1.0 profile bootstrap;

resource {
    fuel: 10000;
    stack: 64KiB;
    allocation: 4KiB;
    tasks: 1;
    workers: 1;
    sync: 0;
    shared: 0B;
    cleanup: 16;
    recursion: 8;
    imports: 0;
}

pub fn ten() -> i32 { 10i32 }
pub fn two() -> i32 { 2i32 }

pub fn main() -> i32 {
    ten() + two()
}
