module conformance.type_forms version 1.0 profile full;

resource [
    fuel: 10000, stack: 64KiB, allocation: 8KiB, tasks: 1, workers: 1,
    sync: 8, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

enum FormError [
    Invalid,
]

record Forms [
    pair: (i32, bool),
    result: Result<i32, FormError>,
    task: Task<i32>,
    outcome: TaskResult<Result<i32, FormError>>,
    lock: Mutex<i32>,
    event: Event,
    semaphore: Semaphore,
    barrier: Barrier,
    latch: Latch,
    ready: AtomicBool,
    count: AtomicU32,
]

pub fn inspect(borrow view: slice<u8>) -> size {
    return 0B;
}
