module conformance.pattern_local_variants version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub enum Signal [
    Low,
    High,
]

pub enum Power [
    Low,
    High,
]

// A bare variant name is resolved by the expected type, so the same spelling
// selects a different enum in each function.
pub fn rank_signal(signal: Signal) -> i32 {
    match (signal) {
        Low => {
            return 1i32;
        }
        High => {
            return 2i32;
        }
    }
}

pub fn rank_power(power: Power) -> i32 {
    match (power) {
        Low => {
            return 10i32;
        }
        Power.High => {
            return 20i32;
        }
    }
}
