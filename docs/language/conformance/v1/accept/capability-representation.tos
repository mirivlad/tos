module conformance.capability_representation version 1.3 profile full;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// TOS Core 1.3 (ADR-0085). `platform.dma.Region` is represented by the region
// family rather than by its own path (`SYSTEM_INTERFACE_V1` §4.3), so the
// argument at its capability position is a `DmaRegion<mut T>` and never a
// `Capability("platform.dma.Region")`. The interface path is still the
// identity: it is what the operation's parameter is declared as and what `uses`
// names.
extern fn dma_device_address(region: platform.dma.Region, offset: size)
    -> Result<u64, i64> uses [platform.dma.Region];

extern fn capability_release(region: platform.dma.Region) -> i64
    uses [platform.dma.Region];

// **Use is not consumption** (ADR-0085 §8). No operation of this interface
// consumes its receiver, so one binding is used three times: affinity is about
// how many values name the object, and using one value twice creates no second
// value.
pub fn translate(area: DmaRegion<mut u64>) -> i64 uses [platform.dma.Region] {
    let first: Result<u64, i64> = dma_device_address(area, 0B);
    let second: Result<u64, i64> = dma_device_address(area, 64B);
    return capability_release(area);
}
