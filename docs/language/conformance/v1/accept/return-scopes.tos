module conformance.return_scopes version 1.0 profile full;

resource [
    fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

pub fn nested_block(ready: bool) -> i32 {
    if (ready) {
        return 1i32;
    }
    return 0i32;
}

async fn scoped_children() -> i32 {
    let mapper = fn (value: i32) {
        return value + 1i32;
    };
    let pending = spawn async {
        return 7i32;
    };
    match (await pending) {
        Completed(value) => {
            return mapper(value);
        }
        Cancelled => {
            return 0i32;
        }
    }
}
