module conformance.visibility_exported_surface version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub record Reading [
    sample: i32,
]

// Private, and never part of a public surface: used only inside a body and by
// a module-private function.
record Scratch [
    tally: i32,
]

pub fn observe(reading: Reading) -> Reading {
    let working: Scratch = Scratch(tally: reading.sample);
    return Reading(sample: working.tally);
}

fn private_helper(scratch: Scratch) -> Scratch {
    return scratch;
}
