module conformance.async_explicit_return version 1.0 profile full;

resource [
    fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

async fn value() -> i32 {
    return 7i32;
}

async fn child() -> i32 {
    let pending = spawn async {
        return 9i32;
    };
    match (await pending) {
        Completed(value) => {
            return value;
        }
        Cancelled => {
            return 0i32;
        }
    }
}
