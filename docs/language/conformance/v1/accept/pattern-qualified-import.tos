module conformance.pattern_qualified_import version 1.0 profile bootstrap;

import conformance.pattern_local_variants as upstream;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 1]

// An imported variant is reached through the import binding as a qualified
// constructor path.
pub fn classify(signal: upstream.Signal) -> i32 {
    match (signal) {
        upstream.Signal.Low => {
            return 1i32;
        }
        upstream.Signal.High => {
            return 2i32;
        }
    }
}
