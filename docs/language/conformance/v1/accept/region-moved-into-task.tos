module conformance.region_moved_into_task version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 2, workers: 1, sync: 2, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0037: an immutably granted region is Transferable, so ownership may
// move into exactly one task.
pub fn main(area: Region<i32>) -> unit {
    let child = spawn parallel { let held = area; };
    let done = join child;
}
