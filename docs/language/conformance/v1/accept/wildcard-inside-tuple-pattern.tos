module conformance.wildcard_inside_tuple_pattern version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// A wildcard binds nothing and therefore takes nothing.
pub fn main() -> i32 {
    let pair = (4i32, 9i32);
    let (_, right) = pair;
    return right;
}
