module conformance.checked_conversion version 1.0 profile bootstrap;

resource [
    fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

pub fn narrow(value: i32) -> Result<u8, ConversionError> {
    return to_u8(value);
}
