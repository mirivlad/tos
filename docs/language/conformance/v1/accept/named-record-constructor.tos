module conformance.named_record_constructor version 1.0 profile bootstrap;

resource [
    fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1,
    sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0,
]

pub record Point [
    x: i32,
    y: i32,
]

pub fn origin() -> Point {
    return Point(x: 0i32, y: 0i32,);
}
