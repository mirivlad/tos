module conformance.tuple_destructuring_let version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0046: a tuple pattern is irrefutable, so `let` may destructure with it.
pub fn main() -> i32 {
    let pair = (2i32, 3i32);
    let (left, right) = pair;
    return left * right;
}
