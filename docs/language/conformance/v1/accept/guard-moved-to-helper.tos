module conformance.guard_moved_to_helper version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 2, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0036 section 4: a move transfers the guard and the release obligation
// with it, so passing one to a helper is not an escape.
pub fn hold(guard: MutexGuard<i32>) -> unit { }

pub fn main(cell: Mutex<i32>) -> unit {
    hold(cell.lock());
}
