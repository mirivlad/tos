module conformance.two_read_guards version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 2, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0036: an RwLock grants several immutable read guards at once.
pub fn main(cell: RwLock<i32>) -> unit {
    let first = cell.read();
    let second = cell.read();
}
