module conformance.lock_outlived_by_guard version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 2, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0036 section 4: the synchronization object must outlive every guard
// it granted.
pub fn consume(cell: Mutex<i32>) -> unit { }

pub fn main(cell: Mutex<i32>) -> unit {
    let guard = cell.lock();
    consume(cell);
}
