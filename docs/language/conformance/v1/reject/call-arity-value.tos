module conformance.call_arity_value version 1.0 profile full;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// The same rule at a callable value. Its parameter list is exact in the way a
// declared function's is; the count is read from the function type.
pub fn main() -> i64 {
    let twice: fn (i64) -> unit = fn (a: i64) { };
    twice(1i64, 2i64);
    return 0i64;
}
