module conformance.imported_unknown_member version 1.0 profile bootstrap;

import conformance.imported_surface as up;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 4]

// The import resolves and the module is known; the member does not exist. Once
// the qualifier has resolved, a missing qualified value member in expression
// position is an unknown value name — it resolves to no module item — and not a
// type disagreement about a signature nobody wrote.
pub fn main() -> i64 {
    return up.no_such_function(1i64);
}
