module conformance.dma_ordering_wrong_region version 1.4 profile full;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// The rule is over the closed `DmaRegion` family and is nominal (ADR-0086 §3).
// An ordinary region is memory nothing else reaches, so there is no device for
// a publication point to publish to; an `MmioRegion` is not memory at all, and
// its ordering is ADR-0081 §9's and stays there.
pub fn publish_plain_memory(area: Region<mut u8>) -> i64 {
    dma_publish(area);
    return 0i64;
}

pub fn consume_a_device_window(window: MmioRegionMut) -> i64 {
    dma_consume(window);
    return 0i64;
}
