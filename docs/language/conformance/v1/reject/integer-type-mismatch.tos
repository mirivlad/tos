module conformance.integer_type_mismatch version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// No nonliteral numeric conversion is implicit, so an i64 does not pass where
// an i32 is declared.
pub fn takes(value: i32) -> i32 {
    return value;
}

pub fn main(wide: i64) -> i32 {
    return takes(wide);
}
