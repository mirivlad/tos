module conformance.share_mutable_region version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 2, shared: 4KiB, cleanup: 16, recursion: 8, imports: 0]

// ADR-0037: a mutably granted region is not Shareable.
pub fn main(area: Region<mut i32>) -> unit {
    let handle = share(area);
}
