module conformance.mutate_while_borrowed version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub record Counter [value: i32]

// An immutable borrow is live across the write, and it may not observe a
// changing value.
pub fn main() -> i32 {
    let mut counter = Counter(value: 0i32);
    let view = borrow counter;
    counter.value = 1i32;
    return 0i32;
}
