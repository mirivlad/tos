module conformance.comma_match_branches version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

enum State [Ready, Stopped]

pub fn main(state: State) -> i32 {
    match (state) {
        Ready => { return 1i32; },
        Stopped => { return 0i32; }
    }
}
