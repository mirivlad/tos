module conformance.noncopy_aggregate version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

record Message [payload: bytes]

pub fn main(message: Message) -> size {
    let copied = message;
    return message.payload[0B];
}
