module conformance.pattern_nonexhaustive_variants version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub enum Signal [
    Low,
    High,
]

// Bare names here are variant patterns, not catch-all bindings, so the match
// is missing the `High` case.
pub fn classify(signal: Signal) -> i32 {
    match (signal) {
        Low => {
            return 1i32;
        }
    }
}
