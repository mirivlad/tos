module conformance.unknown_record_field version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub record Point [x: i32, y: i32]

// `z` is not a field the record declares.
pub fn main() -> Point {
    return Point(x: 1i32, y: 2i32, z: 3i32);
}
