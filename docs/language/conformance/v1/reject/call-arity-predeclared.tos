module conformance.call_arity_predeclared version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// And at a predeclared operation, whose exact arity the contract states
// (ADR-0088). A checked conversion takes one argument.
pub fn main() -> i64 {
    to_u8(1u64, 2u64);
    return 0i64;
}
