// A tuple pattern is irrefutable exactly when every element is, so one
// refutable component makes the whole pattern refutable.
pub enum Mode [Fast, Slow]

pub fn main(pair: (Mode, i32)) -> unit {
    let (Fast, count) = pair;
}
