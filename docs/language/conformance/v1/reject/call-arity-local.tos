module conformance.call_arity_local version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub fn add(a: i64, b: i64) -> i64 { return a + b; }

// docs/43 §4: a call supplies an exact ordered operand list. One argument to a
// two-parameter callee forms no complete positional correspondence, so there is
// nothing for an argument-type code to be about (ADR-0089).
pub fn main() -> i64 {
    return add(1i64);
}
