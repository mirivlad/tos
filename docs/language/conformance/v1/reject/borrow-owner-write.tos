module conformance.borrow_owner_write version 1.0 profile bootstrap;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

pub record Counter [value: i32]

// Writing the owning place while a mutable borrow is live breaks the same
// exclusivity, so it is the conflict code rather than the shared-borrow one.
pub fn main() -> i32 {
    let mut counter = Counter(value: 0i32);
    let held = borrow mut counter;
    counter.value = 1i32;
    return 0i32;
}
