module conformance.dma_ordering_before_minor version 1.3 profile full;

resource [fuel: 1000, stack: 64KiB, allocation: 4KiB, tasks: 1, workers: 1, sync: 0, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// The same operation as the accepted vector, in a module declaring 1.3. A
// module receives the language its header claims, so ADR-0086's ordering
// points are not available to it however capable the frontend compiling it is
// — and the diagnostic names the feature and the minor it needs rather than
// the form it happened to see.
//
// **The signature is not the feature.** A `DmaRegion` parameter is a 1.2 form
// and stays legal here; what 1.3 may not do is write the ordering point.
pub fn drain(ring: DmaRegion<mut u8>) -> u8 {
    dma_consume(ring);
    return ring[0B];
}
