module conformance.dma_region_into_task version 1.0 profile bootstrap;

resource [fuel: 10000, stack: 64KiB, allocation: 4KiB, tasks: 2, workers: 1, sync: 2, shared: 0B, cleanup: 16, recursion: 8, imports: 0]

// ADR-0037 section 2: a DMA region never crosses a task boundary, in either
// granted mode.
pub fn main(area: DmaRegion<i32>) -> unit {
    let child = spawn parallel { let held = area; };
    let done = join child;
}
