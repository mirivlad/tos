module conformance.shared_mutable version 1.0 profile full;

resource [fuel: 100000, stack: 64KiB, allocation: 8KiB, tasks: 2, workers: 2, sync: 0, shared: 0B, cleanup: 32, recursion: 8, imports: 0]

record Counter [value: i32]

pub fn main() -> unit {
    let mut counter = Counter(value: 0i32);
    parallel {
        let first = spawn parallel { counter.value = 1i32; };
        let second = spawn parallel { counter.value = 2i32; };
        let _first_outcome = join first;
        let _second_outcome = join second;
    }
}
